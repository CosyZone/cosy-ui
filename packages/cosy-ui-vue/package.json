{
	"name": "@coffic/cosy-ui-vue",
	"version": "2.0.0-alpha.0",
	"description": "Vue component library for cosy-ui",
	"author": {
		"name": "nookery",
		"url": "https://github.com/nookery"
	},
	"repository": {
		"url": "https://github.com/CosyZone/cosy-ui"
	},
	"license": "MIT",
	"homepage": "https://ui.coffic.cn/en",
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": [
		"*.css"
	],
	"main": "./dist/index.ts",
	"module": "./dist/index.ts",
	"types": "./dist/index.ts",
	"exports": {
		".": {
			"import": "./dist/index.ts",
			"types": "./dist/index.ts"
		},
		"./app.css": "./dist/app.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsx builder/build.ts",
		"build:prod": "tsx builder/build.ts",
		"check": "vue-tsc --noEmit",
		"test": "vitest run"
	},
	"type": "module",
	"peerDependencies": {
		"vue": "^3.5.0"
	},
	"dependencies": {
		"@remixicon/vue": "^4.7.0",
		"shiki": "^3.14.0"
	},
	"devDependencies": {
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^24.9.2",
		"@vitejs/plugin-vue": "^6.0.11",
		"fs-extra": "^11.3.2",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"vue": "^3.5.24",
		"vue-tsc": "^3.3.14"
	}
}
