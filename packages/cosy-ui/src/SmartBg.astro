---
/**
 * @component SmartBg
 * @description 根据关键词自动分配合适的背景色，支持中英文关键词哈希映射，未匹配时使用默认色。可选启用渐变色。
 *
 * @usage
 * <SmartBg keyword="JavaScript" enableGradient>内容</SmartBg>
 *
 * @props
 * @prop {string} [keyword] - 关键词，用于哈希映射背景色
 * @prop {boolean} [enableGradient=false] - 是否启用渐变色
 * @prop {string} [class] - 自定义类名
 * @prop {string} [style] - 自定义内联样式
 */

/** 背景色 key 列表（与下方 CSS 修饰类一一对应） */
const bgKeys = [
    "primary", "success", "danger", "warning", "info", "neutral",
    "forest", "ocean", "sky", "lemon", "orange", "cherry", "grape",
    "banana", "watermelon", "peach", "avocado", "coconut", "blueberry",
    "kiwi", "mint", "sand", "sunset", "lavender", "snow",
];

/** 哈希函数，将字符串映射为数字 */
function hashString(str: string): number {
    let hash = 0;
    for (let i = 0; i < str.length; i++) {
        hash = (hash << 5) - hash + str.charCodeAt(i);
        hash |= 0;
    }
    return Math.abs(hash);
}

/** 关键词到背景 key 的哈希映射 */
function mapKeywordToBgKey(keyword: string): string {
    if (!keyword) return "neutral";
    const hash = hashString(keyword.toLowerCase());
    return bgKeys[hash % bgKeys.length];
}

/**
 * SmartBg 组件属性（组件自包含定义）
 */
export interface ISmartBgProps {
    keyword?: string;
    class?: string;
    style?: string;
    enableGradient?: boolean;
}

const {
    keyword = "",
    class: className = "",
    style = "",
    enableGradient = false,
} = Astro.props as ISmartBgProps;

const bgKey = mapKeywordToBgKey(keyword);
const variant = enableGradient ? "gradient" : "solid";
---

<div class={`cosy-smart-bg cosy-smart-bg--${bgKey}-${variant} ${className}`.trim()} style={style}>
  <slot />
</div>

<style is:global>
    /* SmartBg - 原生 CSS 实现（daisyui corporate 主题色） */
    .cosy-smart-bg {
        box-sizing: border-box;
        height: 100%;
    }

    /* ===== 纯色背景 ===== */
    .cosy-smart-bg--primary-solid { background: #4b6bfb; }
    .cosy-smart-bg--success-solid { background: #16a34a; }
    .cosy-smart-bg--danger-solid { background: #dc2626; }
    .cosy-smart-bg--warning-solid { background: #d97706; }
    .cosy-smart-bg--info-solid { background: #2563eb; }
    .cosy-smart-bg--neutral-solid { background: var(--color-base-200, #e5e7eb); }
    .cosy-smart-bg--forest-solid { background: #15803d; }
    .cosy-smart-bg--ocean-solid { background: #1d4ed8; }
    .cosy-smart-bg--sky-solid { background: #0ea5e9; }
    .cosy-smart-bg--lemon-solid { background: #84cc16; }
    .cosy-smart-bg--orange-solid { background: #f97316; }
    .cosy-smart-bg--cherry-solid { background: #e11d48; }
    .cosy-smart-bg--grape-solid { background: #9333ea; }
    .cosy-smart-bg--banana-solid { background: #eab308; }
    .cosy-smart-bg--watermelon-solid { background: #ec4899; }
    .cosy-smart-bg--peach-solid { background: #fed7aa; }
    .cosy-smart-bg--avocado-solid { background: #65a30d; }
    .cosy-smart-bg--coconut-solid { background: #d6d3d1; }
    .cosy-smart-bg--blueberry-solid { background: #4f46e5; }
    .cosy-smart-bg--kiwi-solid { background: #22c55e; }
    .cosy-smart-bg--mint-solid { background: #14b8a6; }
    .cosy-smart-bg--sand-solid { background: #fde68a; }
    .cosy-smart-bg--sunset-solid { background: #f472b6; }
    .cosy-smart-bg--lavender-solid { background: #d8b4fe; }
    .cosy-smart-bg--snow-solid { background: #ffffff; }

    /* ===== 渐变背景（水平方向，半透明观感） ===== */
    .cosy-smart-bg--primary-gradient { background: linear-gradient(90deg, rgb(75 107 251 / 0.5), rgb(75 107 251 / 0.35)); }
    .cosy-smart-bg--success-gradient { background: linear-gradient(90deg, rgb(22 163 74 / 0.5), rgb(22 163 74 / 0.35)); }
    .cosy-smart-bg--danger-gradient { background: linear-gradient(90deg, rgb(220 38 38 / 0.5), rgb(220 38 38 / 0.35)); }
