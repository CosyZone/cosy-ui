    .cosy-smart-bg--info-gradient { background: linear-gradient(90deg, rgb(37 99 235 / 0.5), rgb(37 99 235 / 0.35)); }
    .cosy-smart-bg--neutral-gradient { background: linear-gradient(90deg, rgb(229 231 235 / 0.6), rgb(209 213 219 / 0.5)); }
    .cosy-smart-bg--forest-gradient { background: linear-gradient(90deg, rgb(21 128 61 / 0.5), rgb(21 128 61 / 0.35)); }
    .cosy-smart-bg--ocean-gradient { background: linear-gradient(90deg, rgb(29 78 216 / 0.5), rgb(29 78 216 / 0.35)); }
    .cosy-smart-bg--sky-gradient { background: linear-gradient(90deg, rgb(14 165 233 / 0.5), rgb(14 165 233 / 0.35)); }
    .cosy-smart-bg--lemon-gradient { background: linear-gradient(90deg, rgb(132 204 22 / 0.5), rgb(132 204 22 / 0.35)); }
    .cosy-smart-bg--orange-gradient { background: linear-gradient(90deg, rgb(249 115 22 / 0.5), rgb(249 115 22 / 0.35)); }
    .cosy-smart-bg--cherry-gradient { background: linear-gradient(90deg, rgb(225 29 72 / 0.5), rgb(225 29 72 / 0.35)); }
    .cosy-smart-bg--grape-gradient { background: linear-gradient(90deg, rgb(147 51 234 / 0.5), rgb(147 51 234 / 0.35)); }
    .cosy-smart-bg--banana-gradient { background: linear-gradient(90deg, rgb(234 179 8 / 0.5), rgb(234 179 8 / 0.35)); }
    .cosy-smart-bg--watermelon-gradient { background: linear-gradient(90deg, rgb(236 72 153 / 0.5), rgb(236 72 153 / 0.35)); }
    .cosy-smart-bg--peach-gradient { background: linear-gradient(90deg, rgb(254 215 170 / 0.6), rgb(254 215 170 / 0.4)); }
    .cosy-smart-bg--avocado-gradient { background: linear-gradient(90deg, rgb(101 163 13 / 0.5), rgb(101 163 13 / 0.35)); }
    .cosy-smart-bg--coconut-gradient { background: linear-gradient(90deg, rgb(214 211 209 / 0.6), rgb(214 211 209 / 0.4)); }
    .cosy-smart-bg--blueberry-gradient { background: linear-gradient(90deg, rgb(79 70 229 / 0.5), rgb(79 70 229 / 0.35)); }
    .cosy-smart-bg--kiwi-gradient { background: linear-gradient(90deg, rgb(34 197 94 / 0.5), rgb(34 197 94 / 0.35)); }
