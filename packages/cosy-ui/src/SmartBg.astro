    .cosy-smart-bg--sand-gradient { background: linear-gradient(90deg, rgb(253 230 138 / 0.6), rgb(253 230 138 / 0.4)); }
    .cosy-smart-bg--sunset-gradient { background: linear-gradient(90deg, rgb(244 114 182 / 0.5), rgb(244 114 182 / 0.35)); }
    .cosy-smart-bg--lavender-gradient { background: linear-gradient(90deg, rgb(216 180 254 / 0.6), rgb(216 180 254 / 0.4)); }
    .cosy-smart-bg--snow-gradient { background: linear-gradient(90deg, rgb(255 255 255 / 0.6), rgb(229 231 235 / 0.5)); }
</style>
