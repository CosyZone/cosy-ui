---
/**
 * @component Logout
 *
 * @description
 * Logout 组件用于创建退出登录确认页面。支持自定义提示信息和按钮文本。
 * 自包含原生 CSS 实现，基于 BEM 类名（cosy-logout），不再依赖 cn()/tailwind/daisyUI。
 *
 * @usage
 * 基本用法：
 * ```astro
 * <Logout />
 * ```
 *
 * 自定义文本：
 * ```astro
 * <Logout
 *   title="确认退出"
 *   message="您确定要退出登录吗？"
 *   confirmText="确认退出"
 *   cancelText="取消"
 * />
 * ```
 *
 * 完全自定义：
 * ```astro
 * <Logout
 *   title="退出系统"
 *   message="退出后需要重新登录才能访问系统"
 *   logo="/path/to/logo.png"
 *   confirmText="确认退出"
 *   cancelText="取消"
 *   customClass="my-logout-page"
 * >
 *   <div slot="footer">
 *     遇到问题？<a href="#">联系支持</a>
 *   </div>
 * </Logout>
 * ```
 *
 * @props
 * @prop {string} [title="退出登录"] - 页面标题
 * @prop {string} [message="您确定要退出当前账号吗？"] - 确认提示信息
 * @prop {string} [logo] - Logo图片路径
 * @prop {string} [confirmText="退出登录"] - 确认按钮文本
 * @prop {string} [cancelText="取消"] - 取消按钮文本
 * @prop {string} [customClass] - 自定义CSS类名
 *
 * @slots
 * @slot header - 页头自定义内容
 * @slot footer - 页脚自定义内容
 */

export interface Props {
    title?: string;
    message?: string;
    logo?: string;
    confirmText?: string;
    cancelText?: string;
    customClass?: string;
}

const {
    title = '退出登录',
    message = '您确定要退出当前账号吗？',
    logo,
    confirmText = '退出登录',
    cancelText = '取消',
    customClass = '',
} = Astro.props;

// 容器类名（BEM 根类 + customClass）
const containerClass = ['cosy-logout', customClass].filter(Boolean).join(' ');
---

<div class={containerClass}>
    <div class="cosy-logout__card">
        <!-- 头部区域 -->
        <div class="cosy-logout__header">
            <slot name="header">
                {
                    logo && (
                        <img
                            class="cosy-logout__logo"
                            src={logo}
                            alt="Logo"
                        />
                    )
                }
                <h2 class="cosy-logout__title">
                    {title}
                </h2>
                <p class="cosy-logout__message">
                    {message}
                </p>
            </slot>
        </div>

        <!-- 按钮区域 -->
        <div class="cosy-logout__actions">
            <button
                type="button"
                class="cosy-logout__confirm-btn">
                {confirmText}
            </button>
            <button
                type="button"
                class="cosy-logout__cancel-btn">
                {cancelText}
            </button>
        </div>

        <!-- 页脚 -->
        <slot name="footer" />
    </div>
</div>

<style is:global>
    /* Logout - 自包含原生 CSS 实现（BEM: cosy-logout） */
    .cosy-logout {
        --cosy-logout-error: #dc2626;
        --cosy-logout-error-focus: #b91c1c;
        --cosy-logout-base-100: #ffffff;
        --cosy-logout-base-200: #e9e9e9;
        --cosy-logout-base-300: #d7d7d7;
        --cosy-logout-base-content: #1d1d1d;

        box-sizing: border-box;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--cosy-logout-base-200);
        padding-top: 3rem;
        padding-bottom: 3rem;
        padding-left: 1rem;
        padding-right: 1rem;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
            "Helvetica Neue", Arial, sans-serif;
        color: var(--cosy-logout-base-content);
    }
    @media (min-width: 640px) {
        .cosy-logout { padding-left: 1.5rem; padding-right: 1.5rem; }
    }
    @media (min-width: 1024px) {
        .cosy-logout { padding-left: 2rem; padding-right: 2rem; }
    }
    .cosy-logout *,
    .cosy-logout *::before,
    .cosy-logout *::after {
        box-sizing: border-box;
    }

    /* 卡片 */
    .cosy-logout__card {
        width: 100%;
        max-width: 28rem;
        background-color: var(--cosy-logout-base-100);
        padding: 2rem;
        border-radius: 0.5rem;
        box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1),
            0 8px 10px -6px rgb(0 0 0 / 0.1);
    }
    .cosy-logout__card > * + * { margin-top: 2rem; }

    /* 头部 */
    .cosy-logout__header { text-align: center; }
    .cosy-logout__logo {
        margin-left: auto;
        margin-right: auto;
        height: 3rem;
        width: auto;
    }
    .cosy-logout__title {
        margin: 1.5rem 0 0;
        font-size: 1.875rem;
        line-height: 2.25rem;
        font-weight: 800;
        color: var(--cosy-logout-base-content);
    }
    .cosy-logout__message {
        margin: 0.5rem 0 0;
        font-size: 0.875rem;
        line-height: 1.25rem;
        color: color-mix(in srgb, var(--cosy-logout-base-content) 60%, transparent);
    }

    /* 按钮区 */
    .cosy-logout__actions > * + * { margin-top: 1rem; }
    .cosy-logout__confirm-btn {
        width: 100%;
        display: flex;
        justify-content: center;
        padding: 0.5rem 1rem;
        border: 1px solid transparent;
        border-radius: 0.375rem;
        font-size: 0.875rem;
        line-height: 1.25rem;
        font-weight: 500;
        color: #fff;
        background-color: var(--cosy-logout-error);
        cursor: pointer;
        transition: background-color 0.15s ease;
    }
    .cosy-logout__confirm-btn:hover { background-color: var(--cosy-logout-error-focus); }
    .cosy-logout__confirm-btn:focus {
        outline: none;
        box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--cosy-logout-error);
    }
    .cosy-logout__cancel-btn {
        width: 100%;
        display: flex;
        justify-content: center;
        padding: 0.5rem 1rem;
        border: 1px solid var(--cosy-logout-base-300);
        border-radius: 0.375rem;
        font-size: 0.875rem;
        line-height: 1.25rem;
        font-weight: 500;
        color: var(--cosy-logout-base-content);
        background-color: var(--cosy-logout-base-100);
        cursor: pointer;
        transition: background-color 0.15s ease;
    }
    .cosy-logout__cancel-btn:hover { background-color: var(--cosy-logout-base-200); }
    .cosy-logout__cancel-btn:focus {
        outline: none;
        box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--cosy-logout-base-300);
    }
</style>
