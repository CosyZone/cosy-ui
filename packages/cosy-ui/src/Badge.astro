---
/**
 * @component Badge
 *
 * @description
 * Badge 组件用于突出显示少量信息，如标签、状态或计数。
 *
 * @usage
 * 基本用法：
 * ```astro
 * <Badge>默认</Badge>
 * <Badge variant="primary">Primary</Badge>
 * ```
 *
 * 不同尺寸：
 * ```astro
 * <Badge size="xs">超小</Badge>
 * <Badge size="sm">小</Badge>
 * <Badge size="md">中</Badge>
 * <Badge size="lg">大</Badge>
 * ```
 *
 * 描边样式：
 * ```astro
 * <Badge outline>描边样式</Badge>
 * <Badge variant="primary" outline>主要描边</Badge>
 * ```
 *
 * @props
 * @prop {string} [class] - 自定义 CSS 类名，用于覆盖默认样式
 * @prop {boolean} [outline=false] - 徽章是否为描边样式，设置为 true 时显示为描边风格
 * @prop {('xs'|'sm'|'md'|'lg')} [size] - 徽章的尺寸，支持 xs、sm、md、lg 四种尺寸
 * @prop {('primary'|'secondary'|'accent'|'ghost'|'info'|'success'|'warning'|'error')} [variant] - 徽章的颜色变体，支持多种预设颜色主题
 *
 * @slots
 * @slot default - 徽章内容，支持任意文本内容
 */

import type { HTMLAttributes } from "astro/types";

/**
 * Badge 组件的基础属性接口（与框架无关，保留以兼容旧导出）
 */
export interface IBadgePropsBase {
	/** 徽章的颜色变体 */
	variant?:
		"primary"
		| "secondary"
		| "accent"
		| "ghost"
		| "info"
		| "success"
		| "warning"
		| "error";
	/** 徽章的尺寸 */
	size?: "xs" | "sm" | "md" | "lg";
	/** 徽章是否为描边样式 @default false */
	outline?: boolean;
	/** 自定义 CSS 类名，用于覆盖默认样式 */
	class?: string;
}

/**
 * Badge 组件属性（组件自包含定义）
 */
export interface IBadgeProps
	extends IBadgePropsBase,
		Omit<HTMLAttributes<"div">, keyof IBadgePropsBase> {}

/** 变体类名映射 */
const variantClassMap: Record<string, string> = {
	primary: "cosy-badge--primary",
	secondary: "cosy-badge--secondary",
	accent: "cosy-badge--accent",
	ghost: "cosy-badge--ghost",
	info: "cosy-badge--info",
	success: "cosy-badge--success",
	warning: "cosy-badge--warning",
	error: "cosy-badge--error",
};

/** 尺寸类名映射 */
const sizeClassMap: Record<string, string> = {
	xs: "cosy-badge--xs",
	sm: "cosy-badge--sm",
	md: "cosy-badge--md",
	lg: "cosy-badge--lg",
};

/**
 * 组合 Badge 类名
 */
function getBadgeClasses(props: IBadgeProps): string {
	const { variant, size, outline = false, class: className = "" } = props;

	return [
		"cosy-badge",
		variant ? variantClassMap[variant] || "" : "",
		size ? sizeClassMap[size] || "" : "",
		outline ? "cosy-badge--outline" : "",
		className,
	]
		.filter(Boolean)
		.join(" ");
}

const props = Astro.props as IBadgeProps;

const slotContent = await Astro.slots.render("default");

const badgeClass = getBadgeClasses(props);
---

<Fragment set:html={`<span class="${badgeClass}">${slotContent}</span>`} />

<style is:global>
    /* Badge - 原生 CSS 实现（daisyUI corporate 主题色） */
    .cosy-badge {
        --cosy-badge-primary: #4b6bfb;
        --cosy-badge-secondary: #7b92b2;
        --cosy-badge-accent: #67baa3;
        --cosy-badge-neutral: #181a2a;
        --cosy-badge-base-content: #1d1d1d;
        --cosy-badge-info: #2563eb;
        --cosy-badge-success: #16a34a;
        --cosy-badge-warning: #d97706;
        --cosy-badge-error: #dc2626;

        --cosy-badge-bg: transparent;
        --cosy-badge-color: var(--cosy-badge-base-content);
        --cosy-badge-border: transparent;

        box-sizing: border-box;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
        height: 2rem;
        padding: 0 0.5rem;
        border: 1px solid var(--cosy-badge-border);
        border-radius: 0.25rem;
        background: var(--cosy-badge-bg);
        color: var(--cosy-badge-color);
        font-size: 0.875rem;
        font-weight: 600;
        line-height: 1;
        white-space: nowrap;
        vertical-align: middle;
    }

    /* 尺寸 */
    .cosy-badge--xs { height: 1rem; padding: 0 0.25rem; font-size: 0.6875rem; }
    .cosy-badge--sm { height: 1.5rem; padding: 0 0.375rem; font-size: 0.75rem; }
    .cosy-badge--md { height: 2rem; padding: 0 0.5rem; font-size: 0.875rem; }
    .cosy-badge--lg { height: 2.5rem; padding: 0 0.75rem; font-size: 1rem; }

    /* 实心变体 */
    .cosy-badge--primary {
        --cosy-badge-bg: var(--cosy-badge-primary);
        --cosy-badge-color: #fff;
        --cosy-badge-border: var(--cosy-badge-primary);
    }
    .cosy-badge--secondary {
        --cosy-badge-bg: var(--cosy-badge-secondary);
        --cosy-badge-color: #fff;
        --cosy-badge-border: var(--cosy-badge-secondary);
    }
    .cosy-badge--accent {
        --cosy-badge-bg: var(--cosy-badge-accent);
        --cosy-badge-color: var(--cosy-badge-base-content);
        --cosy-badge-border: var(--cosy-badge-accent);
    }
    .cosy-badge--info {
        --cosy-badge-bg: var(--cosy-badge-info);
        --cosy-badge-color: #fff;
        --cosy-badge-border: var(--cosy-badge-info);
    }
    .cosy-badge--success {
        --cosy-badge-bg: var(--cosy-badge-success);
        --cosy-badge-color: #fff;
        --cosy-badge-border: var(--cosy-badge-success);
    }
    .cosy-badge--warning {
        --cosy-badge-bg: var(--cosy-badge-warning);
        --cosy-badge-color: #fff;
        --cosy-badge-border: var(--cosy-badge-warning);
    }
    .cosy-badge--error {
        --cosy-badge-bg: var(--cosy-badge-error);
        --cosy-badge-color: #fff;
        --cosy-badge-border: var(--cosy-badge-error);
    }

    /* ghost */
    .cosy-badge--ghost {
        --cosy-badge-bg: transparent;
        --cosy-badge-border: transparent;
        --cosy-badge-color: var(--cosy-badge-base-content);
    }

    /* outline */
    .cosy-badge--outline {
        --cosy-badge-bg: transparent;
        --cosy-badge-border: currentColor;
    }
</style>
