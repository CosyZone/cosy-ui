---
/**
 * @component Header
 *
 * @description
 * Header 组件是一个用于网站顶部导航的布局组件，提供了logo、导航菜单、语言切换、主题切换等功能。
 * 组件支持响应式设计，在不同屏幕尺寸下有良好的显示效果，并可选择固定在页面顶部。
 *
 * @usage
 * 基本用法：
 * ```astro
 * <Header logo={logo} logoHref="/" navItems={navItems} />
 * ```
 *
 * @props
 * @prop {BackgroundColor} [background='base-300/90'] - 自定义背景色
 * @prop {ShadowSize} [shadow='md'] - 阴影强度
 * @prop {TextColor} [textColor='base-content'] - 文本颜色
 * @prop {HeightSize} [height='3xs'] - 导航栏高度
 * @prop {ImageSource} [logo] - Logo图片
 * @prop {string} [logoHref='/'] - Logo 链接地址
 * @prop {INavItem[]} [navItems=[]] - 导航菜单项
 * @prop {'start'|'center'|'end'} [navPosition='center'] - 导航栏位置
 * @prop {boolean} [sticky=true] - 是否固定在顶部
 * @prop {boolean} [showThemeSwitcher=true] - 是否显示主题切换按钮
 * @prop {number} [gap=2] - 导航项之间的间距
 * @prop {string[]} [locales] - 支持的语言列表
 * @prop {any} [astroI18n] - 完整的 astro:i18n 模块
 */

import type { HTMLAttributes } from "astro/types";
import { LinkUtil } from "../internal/utils/link";
import Modal from "./Modal.astro";
import Image from "./Image.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import MenuIcon from "./MenuIcon.astro";
import SunCloudyIcon from "./SunCloudyIcon.astro";
import CheckIcon from "./CheckIcon.astro";

export interface INavItem {
	title: string;
	href: string;
	icon?: string;
	onClick?: string;
	children?: INavItem[];
}

/** 导航项间距类名映射 */
const headerGapMap = {
	0: "cosy-header__nav-list--gap-0",
	1: "cosy-header__nav-list--gap-1",
	2: "cosy-header__nav-list--gap-2",
	3: "cosy-header__nav-list--gap-3",
	4: "cosy-header__nav-list--gap-4",
	6: "cosy-header__nav-list--gap-6",
	8: "cosy-header__nav-list--gap-8",
	10: "cosy-header__nav-list--gap-10",
	12: "cosy-header__nav-list--gap-12",
} as const;

/** 高度映射 */
const headerHeightMap = {
	"3xs": "cosy-header--height-3xs",
	xs: "cosy-header--height-xs",
	sm: "cosy-header--height-sm",
	md: "cosy-header--height-md",
	lg: "cosy-header--height-lg",
	xl: "cosy-header--height-xl",
	"2xl": "cosy-header--height-2xl",
	"3xl": "cosy-header--height-3xl",
	"4xl": "cosy-header--height-4xl",
	"5xl": "cosy-header--height-5xl",
	"6xl": "cosy-header--height-6xl",
} as const;

/** 阴影映射 */
const headerShadowMap = {
	none: "cosy-header--shadow-none",
	sm: "cosy-header--shadow-sm",
	md: "cosy-header--shadow-md",
	lg: "cosy-header--shadow-lg",
	xl: "cosy-header--shadow-xl",
	"2xl": "cosy-header--shadow-2xl",
} as const;

export interface IHeaderProps extends Omit<HTMLAttributes<"header">, "class"> {
	/** 自定义背景色 */
	background?: string;
	/** 阴影强度 @default 'md' */
	shadow?: keyof typeof headerShadowMap;
	/** 文本颜色 @default 'base-content' */
	textColor?: string;
	/** 完整的 astro:i18n 模块 */
	astroI18n?: any;
	/** 支持的语言列表 */
	locales?: string[];
	/** 导航栏高度 @default '3xs' */
	height?: string;
	/** Logo图片 */
	logo?: ImageSource;
	/** Logo 链接地址 @default "/" */
	logoHref?: string;
	/** 导航菜单项 */
	navItems?: INavItem[];
	/** 导航栏位置 @default "center" */
	navPosition?: "start" | "center" | "end";
	/** 水平内边距 @default "none" */
	paddingHorizontal?: string;
	/** 垂直内边距 @default "none" */
	paddingVertical?: string;
	/** 圆角大小 @default "none" */
	rounded?: string;
	/** 是否显示主题切换按钮 @default true */
	showThemeSwitcher?: boolean;
	/** 是否固定在顶部 @default true */
	sticky?: boolean;
	/** 导航项之间的间距 @default 2 */
	gap?: number;
	/** 自定义类名 */
	class?: string;
}

const {
	height = "3xs",
	logo,
	logoHref = LinkUtil.getBaseUrl(),
	navItems = [],
	sticky = true,
	shadow = "md",
	navPosition = "center",
	showThemeSwitcher = true,
	gap = 2,
	locales,
	class: className = "",
	background = "base-300/90",
	textColor = "base-content",
	rounded = "none",
} = Astro.props as IHeaderProps;

const resolveHeaderColor = (name: string) => {
	if (name === "white") return "#fff";
	if (name === "black") return "#000";
	if (name === "transparent" || name === "none") return "transparent";
	return `var(--color-${name}, currentColor)`;
};

const resolveHeaderBackground = (value: string) => {
	if (!value || value === "none" || value === "transparent") return "transparent";
	const [name, opacity] = value.split("/");
	const color = resolveHeaderColor(name);
	return opacity
		? `color-mix(in srgb, ${color} ${opacity}%, transparent)`
		: color;
};

const headerRadiusMap: Record<string, string> = {
	none: "0",
	sm: "0.125rem",
	md: "0.375rem",
	lg: "0.5rem",
	xl: "0.75rem",
	"2xl": "1rem",
	"3xl": "1.5rem",
	full: "9999px",
};

const headerStyle = [
	`background:${resolveHeaderBackground(background)}`,
	`color:${resolveHeaderColor(textColor)}`,
	rounded !== "none" ? `border-radius:${headerRadiusMap[rounded] || "0"}` : "",
	rounded !== "none" ? "overflow:hidden" : "",
]
	.filter(Boolean)
	.join(";");

const currentPath = Astro.url.pathname;
const activeLink = LinkUtil.getActiveLink(
	currentPath,
	navItems.map((item: INavItem) => item.href),
);

const headerHeightClass = (headerHeightMap as Record<string, string>)[height] || "";
const headerShadowClass = headerShadowMap[shadow] || "";
const headerGapClass = headerGapMap[gap as keyof typeof headerGapMap] || headerGapMap[2];

/** 构建导航项 HTML */
function renderNavItems(items: INavItem[], active: string): string {
	return items
		.map(
			(item) => `
			<li class="cosy-header__nav-item">
				<a href="${item.href}" class="cosy-header__nav-link ${active === item.href ? "cosy-header__nav-link--active" : ""}">
					${item.title}
				</a>
			</li>
		`,
		)
		.join("");
}

const navItemsHtml = renderNavItems(navItems, activeLink);
const mobileNavItemsHtml = renderNavItems(navItems, activeLink);

/** 构建主题切换下拉 */
const themeOptions = [
	{ id: "light", name: "浅色" },
	{ id: "dark", name: "深色" },
	{ id: "corporate", name: "Corporate" },
];

const headerClasses = [
	"cosy-header",
	sticky ? "cosy-header--sticky" : "",
	headerHeightClass,
	headerShadowClass,
	className,
]
	.filter(Boolean)
	.join(" ");
type ImageSource = string | import("astro").ImageMetadata;

---

<header class={headerClasses} style={headerStyle}>
	<div class="cosy-header__inner">
		<!-- 左侧区域 -->
		<div class="cosy-header__start">
			{logo && (
				<a href={logoHref} class="cosy-header__logo-link" transition:persist>
					<Image
						src={logo}
						alt="logo"
						width={100}
						height={100}
						rounded="none"
						showPlaceholder={false}
						class="cosy-header__logo-img"
					/>
				</a>
			)}
			{navPosition === "start" && navItems.length > 0 && (
				<nav class="cosy-header__nav cosy-header__nav--desktop">
					<ul class={`cosy-header__nav-list ${headerGapClass}`} set:html={navItemsHtml} />
				</nav>
			)}
			<slot name="navbar-start" />
		</div>

		<!-- 中间区域 -->
		<div class="cosy-header__center">
			{navPosition === "center" && navItems.length > 0 && (
				<nav class="cosy-header__nav cosy-header__nav--desktop">
					<ul class={`cosy-header__nav-list ${headerGapClass}`} set:html={navItemsHtml} />
				</nav>
			)}
			<slot name="navbar-center" />
		</div>

		<!-- 右侧区域 -->
		<div class="cosy-header__end">
			{navPosition === "end" && navItems.length > 0 && (
				<nav class="cosy-header__nav cosy-header__nav--desktop">
					<ul class={`cosy-header__nav-list cosy-header__nav-list--gap-4`} set:html={navItemsHtml} />
				</nav>
			)}

			{showThemeSwitcher && (
				<div class="cosy-header__theme-switcher">
					<button type="button" class="cosy-header__theme-btn" aria-label="切换主题">
						<SunCloudyIcon size="16px" />
					</button>
					<ul class="cosy-header__theme-dropdown">
						{
							themeOptions.map((theme) => (
								<li>
									<button type="button" class="cosy-header__theme-item" data-theme-id={theme.id}>
										<span>{theme.name}</span>
										<CheckIcon size="16px" class="cosy-header__theme-check" />
									</button>
								</li>
							))
						}
					</ul>
				</div>
			)}

			{locales && locales.length > 0 && <LanguageSwitcher locales={locales} />}

			{navItems.length > 0 && (
				<button
					type="button"
					class="cosy-header__menu-btn"
					aria-label="打开移动导航"
					data-modal-target="mobile-nav"
				>
					<MenuIcon class="cosy-header__menu-icon" />
				</button>
			)}

			<slot name="navbar-end" />
		</div>
	</div>
</header>

{
	navItems.length > 0 && (
		<Modal id="mobile-nav" title="导航菜单">
			<nav class="cosy-header__mobile-nav">
				<ul class="cosy-header__nav-list cosy-header__nav-list--vertical" set:html={mobileNavItemsHtml} />
			</nav>
		</Modal>
	)
}

<style is:global>
	/* Header - 原生 CSS 实现 */
	.cosy-header {
		--cosy-header-primary: var(--color-primary, #4b6bfb);
		--cosy-header-neutral: var(--color-neutral, #181a2a);
		--cosy-header-base-100: var(--color-base-100, #ffffff);
		--cosy-header-base-200: var(--color-base-200, #e9e9e9);
		--cosy-header-base-300: var(--color-base-300, #d7d7d7);
		--cosy-header-base-content: var(--color-base-content, #1d1d1d);

		box-sizing: border-box;
		width: 100%;
		z-index: 50;
		padding: 0 1rem;
	}

	.cosy-header--sticky {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
	}

	/* 高度变体 */
	.cosy-header--height-3xs { --cosy-header-height: 2.5rem; }
	.cosy-header--height-xs { --cosy-header-height: 3rem; }
	.cosy-header--height-sm { --cosy-header-height: 3.5rem; }
	.cosy-header--height-md { --cosy-header-height: 4rem; }
	.cosy-header--height-lg { --cosy-header-height: 4.5rem; }
	.cosy-header--height-xl { --cosy-header-height: 5rem; }
	.cosy-header--height-2xl { --cosy-header-height: 6rem; }
	.cosy-header--height-3xl { --cosy-header-height: 7rem; }
	.cosy-header--height-4xl { --cosy-header-height: 8rem; }
	.cosy-header--height-5xl { --cosy-header-height: 10rem; }
	.cosy-header--height-6xl { --cosy-header-height: 12rem; }

	/* 阴影变体 */
	.cosy-header--shadow-none { box-shadow: none; }
	.cosy-header--shadow-sm { box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05); }
	.cosy-header--shadow-md { box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1); }
	.cosy-header--shadow-lg { box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1); }
	.cosy-header--shadow-xl { box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1); }
	.cosy-header--shadow-2xl { box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25); }

	/* 内部容器 */
	.cosy-header__inner {
		display: flex;
		flex: 1 1 0%;
		align-items: center;
		height: var(--cosy-header-height, 4rem);
		backdrop-filter: blur(8px);
		border-radius: 0;
	}

	/* 三段布局 */
	.cosy-header__start,
	.cosy-header__center,
	.cosy-header__end {
		display: flex;
		align-items: center;
	}

	.cosy-header__start {
		flex: 1 1 0%;
		justify-content: flex-start;
		gap: 0.5rem;
	}

	.cosy-header__center {
		flex: 0 0 auto;
	}

	.cosy-header__end {
		flex: 1 1 0%;
		justify-content: flex-end;
		gap: 0.5rem;
		padding-right: 0.25rem;
	}

	/* Logo */
	.cosy-header__logo-link {
		display: inline-flex;
		align-items: center;
		height: 100%;
		padding: 0.25rem;
		text-decoration: none;
		color: inherit;
		border-radius: 0.375rem;
		transition: background-color 0.15s ease;
	}

	.cosy-header__logo-link:hover {
		background: color-mix(in srgb, currentColor 10%, transparent);
	}

	.cosy-header__logo-img {
		height: 2rem;
		width: 2rem;
		object-fit: contain;
	}

	/* 导航列表 */
	.cosy-header__nav-list {
		display: flex;
		list-style: none;
		margin: 0;
		padding: 0 0.25rem;
	}

	.cosy-header__nav-list--horizontal {
		flex-direction: row;
	}

	.cosy-header__nav-list--vertical {
		flex-direction: column;
		width: 100%;
	}

	/* 间距变体 */
	.cosy-header__nav-list--gap-0 { gap: 0; }
	.cosy-header__nav-list--gap-1 { gap: 0.25rem; }
	.cosy-header__nav-list--gap-2 { gap: 0.5rem; }
	.cosy-header__nav-list--gap-3 { gap: 0.75rem; }
	.cosy-header__nav-list--gap-4 { gap: 1rem; }
	.cosy-header__nav-list--gap-6 { gap: 1.5rem; }
	.cosy-header__nav-list--gap-8 { gap: 2rem; }
	.cosy-header__nav-list--gap-10 { gap: 2.5rem; }
	.cosy-header__nav-list--gap-12 { gap: 3rem; }

	.cosy-header__nav-item {
		display: flex;
		align-items: center;
	}

	.cosy-header__nav-link {
		display: inline-flex;
		align-items: center;
		padding: 0.25rem 0.5rem;
		border-radius: 0.375rem;
		text-decoration: none;
		color: inherit;
		font-size: 0.875rem;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.cosy-header__nav-link:hover {
		background: color-mix(in srgb, currentColor 10%, transparent);
	}

	.cosy-header__nav-link--active {
		color: var(--cosy-header-primary);
		font-weight: 600;
	}

	/* 桌面端导航在小屏幕隐藏 */
	@media (max-width: 1023px) {
		.cosy-header__nav--desktop {
			display: none;
		}
		.cosy-header__menu-btn {
			display: inline-flex;
		}
	}

	@media (min-width: 1024px) {
		.cosy-header__menu-btn {
			display: none;
		}
	}

	/* 主题切换器 */
	.cosy-header__theme-switcher {
		position: relative;
		display: inline-block;
	}

	.cosy-header__theme-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: none;
		border-radius: 9999px;
		background: transparent;
		color: inherit;
		cursor: pointer;
		transition: background-color 0.15s ease;
	}

	.cosy-header__theme-btn:hover {
		background: color-mix(in srgb, currentColor 12%, transparent);
	}

	.cosy-header__theme-dropdown {
		position: absolute;
		right: 0;
		top: 100%;
		min-width: 10rem;
		margin-top: 0.25rem;
		padding: 0.5rem;
		list-style: none;
		background: var(--cosy-header-base-200);
		border-radius: 0.5rem;
		box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1);
		z-index: 10;
		display: none;
	}

	.cosy-header__theme-switcher:hover .cosy-header__theme-dropdown,
	.cosy-header__theme-switcher:focus-within .cosy-header__theme-dropdown {
		display: block;
	}

	.cosy-header__theme-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		padding: 0.5rem 0.75rem;
		border: none;
		border-radius: 0.375rem;
		background: transparent;
		color: inherit;
		font-size: 0.875rem;
		text-align: left;
		cursor: pointer;
		transition: background-color 0.15s ease;
	}

	.cosy-header__theme-item:hover {
		background: color-mix(in srgb, currentColor 10%, transparent);
	}

	.cosy-header__theme-check {
		display: none;
		margin-left: 0.5rem;
		color: var(--cosy-header-primary);
	}

	.cosy-header__theme-item[data-active="true"] .cosy-header__theme-check {
		display: inline-block;
	}

	/* 移动端菜单按钮 */
	.cosy-header__menu-btn {
		display: none;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: none;
		border-radius: 0.375rem;
		background: transparent;
		color: inherit;
		cursor: pointer;
	}

	.cosy-header__menu-icon {
		width: 1.25rem;
		height: 1.25rem;
	}

	/* 移动端导航 */
	.cosy-header__mobile-nav {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.cosy-header__mobile-nav .cosy-header__nav-list {
		width: 100%;
	}
</style>

<script>
	import { createThemeManager } from "../internal/utils/theme";

	const themeManager = createThemeManager();

	function initThemeSwitcher() {
		document.querySelectorAll<HTMLElement>(".cosy-header__theme-item").forEach((item) => {
			// 避免重复绑定
			if ((item as any).__cosyBound) return;
			(item as any).__cosyBound = true;

			item.addEventListener("click", () => {
				const theme = item.getAttribute("data-theme-id");
				if (theme) {
					themeManager.setTheme(theme);
					// 更新选中状态
					document
						.querySelectorAll(".cosy-header__theme-item")
						.forEach((el) => el.removeAttribute("data-active"));
					item.setAttribute("data-active", "true");
				}
			});
		});
	}

	document.addEventListener("DOMContentLoaded", initThemeSwitcher);
	document.addEventListener("astro:after-swap", initThemeSwitcher);
	initThemeSwitcher();
</script>
