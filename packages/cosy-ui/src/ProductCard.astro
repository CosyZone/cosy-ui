---
/**
 * @component ProductCard
 *
 * @description
 * ProductCard 组件用于展示产品信息，包括名称、图片、描述和多个链接按钮。
 * 支持 xs/sm/md/lg/xl 五种尺寸，悬停阴影效果。
 *
 * @usage
 * ```astro
 * <ProductCard
 *   name="产品名称"
 *   image="/images/product1.jpg"
 *   description="产品描述"
 *   productUrl="https://example.com"
 * />
 * ```
 *
 * @props
 * @prop {string} name - 产品名称
 * @prop {ImageSource} image - 产品图片
 * @prop {string} description - 产品描述
 * @prop {string} [appStoreUrl] - App Store 链接
 * @prop {string} [productUrl] - 产品官网链接
 * @prop {string} [githubUrl] - GitHub 仓库链接
 * @prop {('xs'|'sm'|'md'|'lg'|'xl')} [size='md'] - 卡片尺寸
 * @prop {string} [primaryButtonText] - 主按钮文本
 * @prop {string} [secondaryButtonText='App Store'] - 次按钮文本
 * @prop {string} [githubButtonText='GitHub'] - GitHub 按钮文本
 * @prop {string} [lang] - 语言设置（zh-cn / en）
 * @prop {('row'|'column')} [buttonLayout='row'] - 按钮布局方向
 * @prop {boolean} [equalHeight=false] - 等高卡片
 * @prop {number} [descriptionLines] - 描述最大行数
 * @prop {string} [class] - 自定义类名
 * @prop {('none'|'sm'|'md'|'lg'|'xl')} [shadow='md'] - 阴影
 * @prop {BackgroundColor} [background] - 背景色
 * @prop {boolean} [muted=false] - 柔和色
 */

import Button from "./Button.astro";
import Image from "./Image.astro";
import type { ImageSource } from "./Image.astro";
import { AppStoreIcon, LinkIcon } from "../icons";
import SocialIcon from "./SocialIcon.astro";

type ProductCardSize = "xs" | "sm" | "md" | "lg" | "xl";

export interface Props {
	name: string;
	image: ImageSource;
	description: string;
	appStoreUrl?: string;
	productUrl?: string;
	githubUrl?: string;
	size?: ProductCardSize;
	primaryButtonText?: string;
	secondaryButtonText?: string;
	githubButtonText?: string;
	lang?: string;
	buttonLayout?: "row" | "column";
	equalHeight?: boolean;
	descriptionLines?: number;
	class?: string;
	shadow?: "none" | "sm" | "md" | "lg" | "xl";
	background?: BackgroundColor;
	muted?: boolean;
}

const {
	name,
	image,
	description,
	appStoreUrl,
	productUrl,
	githubUrl,
	size = "md",
	primaryButtonText,
	secondaryButtonText = "App Store",
	githubButtonText = "GitHub",
	buttonLayout = "row",
	equalHeight = false,
	descriptionLines,
	class: className = "",
	shadow = "md",
	background,
	muted = false,
	lang,
} = Astro.props as Props;

const effectivePrimaryButtonText =
	primaryButtonText ?? (lang === "en" ? "Visit Website" : "访问官网");

// 尺寸配置
const sizeConfig = {
	xs: { maxWidth: "200px", figurePadding: "0.5rem", imgW: 150, imgH: 100, titleSize: "0.875rem", descSize: "0.75rem", bodyPadding: "0.75rem 1rem", btnSize: "xs" as const, cardH: "280px", figureH: "100px", bodyH: "180px" },
	sm: { maxWidth: "250px", figurePadding: "0.75rem", imgW: 200, imgH: 133, titleSize: "1rem", descSize: "0.875rem", bodyPadding: "1rem 1.25rem", btnSize: "sm" as const, cardH: "360px", figureH: "133px", bodyH: "227px" },
	md: { maxWidth: "320px", figurePadding: "1rem", imgW: 300, imgH: 200, titleSize: "1.25rem", descSize: "1rem", bodyPadding: "1.5rem 1.5rem", btnSize: "md" as const, cardH: "450px", figureH: "200px", bodyH: "250px" },
	lg: { maxWidth: "400px", figurePadding: "1.25rem", imgW: 380, imgH: 253, titleSize: "1.5rem", descSize: "1.125rem", bodyPadding: "1.75rem 1.75rem", btnSize: "lg" as const, cardH: "550px", figureH: "253px", bodyH: "297px" },
	xl: { maxWidth: "500px", figurePadding: "1.5rem", imgW: 480, imgH: 320, titleSize: "1.875rem", descSize: "1.25rem", bodyPadding: "2rem 2rem", btnSize: "lg" as const, cardH: "650px", figureH: "320px", bodyH: "330px" },
} as const;

const cfg = sizeConfig[size];

// 背景色 CSS 变量解析
const bgColorVarMap: Record<string, string> = {
	primary: "#4b6bfb",
	secondary: "#7b92b2",
	accent: "#67baa3",
	neutral: "#181a2a",
	"base-100": "#ffffff",
	"base-200": "#e9e9e9",
	"base-300": "#d7d7d7",
	success: "#16a34a",
	warning: "#d97706",
	error: "#dc2626",
	info: "#2563eb",
};

function resolveCardBg(bg?: BackgroundColor): string {
	if (!bg) return "background-color: #e9e9e9;";
	// 渐变背景直接忽略，使用默认
	if (bg.startsWith("gradient") || bg.startsWith("dot-") || bg === "glassmorphism" || bg === "noise") {
		return "background-color: #e9e9e9;";
	}
	const idx = bg.indexOf("/");
	const name = idx >= 0 ? bg.slice(0, idx) : bg;
	const op = idx >= 0 ? bg.slice(idx + 1) : "";
	const color = bgColorVarMap[name];
	if (!color) return "background-color: #e9e9e9;";
	if (!op) return `background-color: ${color};`;
	return `background-color: color-mix(in srgb, ${color} ${op}%, transparent);`;
}

// 按钮布局类
const buttonCount = [productUrl, appStoreUrl, githubUrl].filter(Boolean).length;
const buttonFlexClass =
	buttonLayout === "column"
		? "cosy-product-card__btn--full"
		: buttonCount <= 1
			? "cosy-product-card__btn--full"
			: "cosy-product-card__btn--flex";

// 根元素样式
const rootStyleParts = [
	`max-width: ${cfg.maxWidth};`,
	resolveCardBg(background),
	equalHeight ? `height: ${cfg.cardH};` : "",
];
const rootStyle = rootStyleParts.filter(Boolean).join(" ");

const shadowMod = `cosy-product-card--shadow-${shadow}`;
const sizeMod = `cosy-product-card--${size}`;

// 描述行数
const descLineClamp = descriptionLines || (size === "xs" ? 2 : size === "sm" ? 3 : 3);
type BackgroundColor = string;

---

<div
	class={[
		"cosy-product-card",
		sizeMod,
		shadowMod,
		muted ? "cosy-product-card--muted" : "",
		className,
	].filter(Boolean).join(" ")}
	style={rootStyle}>
	<figure
		class="cosy-product-card__figure"
		style={`padding: ${cfg.figurePadding}; ${equalHeight ? `height: ${cfg.figureH};` : ""}`.trim()}>
		<Image
			src={image}
			alt={`${name} product image`}
			width={cfg.imgW}
			height={cfg.imgH}
			rounded="lg"
			transition="fade"
			hover="brightness"
			class="cosy-product-card__img"
			loading="lazy"
			showError={true}
		/>
	</figure>
	<div
		class="cosy-product-card__body"
		style={`padding: ${cfg.bodyPadding}; ${equalHeight ? `height: ${cfg.bodyH};` : ""}`.trim()}>
		<h2 class="cosy-product-card__title" style={`font-size: ${cfg.titleSize};`}>
			{name}
		</h2>
		<p
			class="cosy-product-card__desc"
			style={`font-size: ${cfg.descSize}; -webkit-line-clamp: ${descLineClamp};`}>
			{description}
		</p>

		<div class={`cosy-product-card__buttons ${buttonLayout === "column" ? "cosy-product-card__buttons--col" : ""}`.trim()}>
			{
				productUrl && (
					<Button
						href={productUrl}
						target="_blank"
						variant="primary"
						class={buttonFlexClass}
						size={cfg.btnSize}
						aria-label={`Visit ${name}'s website`}>
						<span slot="icon-left">
							<LinkIcon size="22px" />
						</span>
						{effectivePrimaryButtonText}
					</Button>
				)
			}
			{
				appStoreUrl && (
					<Button
						href={appStoreUrl}
						target="_blank"
						variant="secondary"
						class={buttonFlexClass}
						size={cfg.btnSize}
						aria-label={`Download ${name} on App Store`}>
						<span slot="icon-left">
							<AppStoreIcon size="22px" />
						</span>
						{secondaryButtonText}
					</Button>
				)
			}
			{
				githubUrl && (
					<Button
						href={githubUrl}
						target="_blank"
						variant="info"
						class={buttonFlexClass}
						size={cfg.btnSize}
						aria-label={`View ${name}'s GitHub repository`}>
						<span slot="icon-left">
							<SocialIcon platform="github" size="22px" />
						</span>
						{githubButtonText}
					</Button>
				)
			}
		</div>
	</div>
</div>

<style is:global>
	/* ProductCard - 原生 CSS 实现 */
	.cosy-product-card {
		display: flex;
		flex-direction: column;
		border-radius: 0.5rem;
		overflow: hidden;
		transition: box-shadow 0.3s ease;
	}

	/* 阴影 */
	.cosy-product-card--shadow-none { box-shadow: none; }
	.cosy-product-card--shadow-sm { box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05); }
	.cosy-product-card--shadow-sm:hover { box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); }
	.cosy-product-card--shadow-md { box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1); }
	.cosy-product-card--shadow-md:hover { box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1); }
	.cosy-product-card--shadow-lg { box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1); }
	.cosy-product-card--shadow-lg:hover { box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1); }
	.cosy-product-card--shadow-xl { box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1); }
	.cosy-product-card--shadow-xl:hover { box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25); }

	.cosy-product-card__figure {
		margin: 0;
	}
	.cosy-product-card__img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cosy-product-card__body {
		display: flex;
		flex-direction: column;
		flex: 1 1 auto;
	}

	.cosy-product-card__title {
		margin: 0 0 0.5rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.cosy-product-card__desc {
		margin: 0 0 1rem;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.cosy-product-card__buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: auto;
	}
	.cosy-product-card__buttons--col {
		flex-direction: column;
		flex-wrap: nowrap;
	}

	.cosy-product-card__btn--full {
		width: 100%;
	}
	.cosy-product-card__btn--flex {
		flex: 1 1 0%;
	}

	.cosy-product-card--muted {
		opacity: 0.6;
	}
</style>
