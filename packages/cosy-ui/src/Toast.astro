---
/**
 * @component Toast
 *
 * @description
 * Toast 组件用于显示临时的通知消息，支持多种类型。
 * 通常不直接使用，而是通过全局的 toast 系统（window.showToast）来显示。
 * 本组件为自包含单文件组件，使用 BEM 命名与原生 CSS，不依赖 cn()/tailwind/daisyUI。
 *
 * @usage
 * 通过全局函数使用：
 * ```javascript
 * // 基本用法
 * showToast('操作成功完成！');
 *
 * // 带类型的用法
 * showToast({ message: '保存成功！', type: 'success', duration: 2000 });
 *
 * // 关闭特定 toast
 * const toastId = showToast('正在处理...');
 * setTimeout(() => closeToast(toastId), 1000);
 *
 * // 清除所有 toast
 * clearAllToasts();
 * ```
 *
 * @props
 * @prop {string} message - 显示的消息内容
 * @prop {('info'|'success'|'warning'|'error')} type - 消息类型，影响样式和图标
 * @prop {string} id - 唯一标识符
 */

import {
	CloseIcon,
	ErrorIcon,
	InfoIcon,
	SuccessIcon,
	WarningIcon,
} from "../icons";

/**
 * Toast 类型
 */
export type ToastType = "info" | "success" | "warning" | "error";

/**
 * Toast 配置接口
 */
export interface ToastConfig {
	message: string;
	type?: ToastType;
	/** 毫秒，默认 3000 */
	duration?: number;
	/** 如果不提供会自动生成 */
	id?: string;
}

/**
 * Toast 项接口
 */
export interface ToastItem extends Required<ToastConfig> {
	id: string;
	createdAt: number;
}

/**
 * Toast 组件属性
 */
export interface Props {
	/** 显示的消息内容 */
	message: string;
	/** 消息类型，影响样式和图标 */
	type: ToastType;
	/** 唯一标识符 */
	id: string;
}

/** 类型修饰符类名映射 */
const toastTypeClassMap = {
	info: "cosy-toast--info",
	success: "cosy-toast--success",
	warning: "cosy-toast--warning",
	error: "cosy-toast--error",
} as const;

/** 类型图标组件映射 */
const toastIconMap = {
	info: InfoIcon,
	success: SuccessIcon,
	warning: WarningIcon,
	error: ErrorIcon,
} as const;

const { message, type, id } = Astro.props as Props;

const IconComponent = toastIconMap[type];

const toastClass = ["cosy-toast", toastTypeClassMap[type]].filter(Boolean).join(" ");
---

<div class={toastClass} data-toast-id={id} role="alert" aria-live="polite">
	<span class="cosy-toast__icon">
		<IconComponent size="20px" />
	</span>
	<span class="cosy-toast__message">{message}</span>
	<button
		class="cosy-toast__close"
		onclick={`window.closeToast?.('${id}')`}
		aria-label="关闭通知"
		type="button">
		<CloseIcon size="16px" />
	</button>
</div>

<style is:global>
	/* Toast - 原生 CSS 实现（自包含） */
	.cosy-toast {
		--cosy-toast-color: #2563eb;

		box-sizing: border-box;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
		padding: 0.75rem 0.5rem 0.75rem 1rem;
		border-radius: 0.5rem;
		font-size: 0.875rem;
		line-height: 1.5;
		color: #fff;
		background: var(--cosy-toast-color);
		border: 1px solid var(--cosy-toast-color);
		box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
		pointer-events: auto;
		transform: translateX(0);
		opacity: 1;
		transition:
			transform 0.3s ease-in-out,
			opacity 0.3s ease-in-out;
	}

	/* 类型色 */
	.cosy-toast--info {
		--cosy-toast-color: #2563eb;
	}
	.cosy-toast--success {
		--cosy-toast-color: #16a34a;
	}
	.cosy-toast--warning {
		--cosy-toast-color: #d97706;
	}
	.cosy-toast--error {
		--cosy-toast-color: #dc2626;
	}

	/* 入场/退场起始态：从右侧滑入 */
	.cosy-toast--enter {
		transform: translateX(100%);
		opacity: 0;
	}

	/* 内部结构 */
	.cosy-toast__icon {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}
	.cosy-toast__message {
		flex: 1 1 auto;
		min-width: 0;
		font-weight: 500;
	}
	.cosy-toast__close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.5rem;
		height: 1.5rem;
		padding: 0;
		border: none;
		border-radius: 9999px;
		background: transparent;
		color: #fff;
		cursor: pointer;
		flex-shrink: 0;
		opacity: 0.7;
		transition:
			opacity 0.15s ease,
			background-color 0.15s ease;
	}
	.cosy-toast__close:hover {
		opacity: 1;
		background: rgb(255 255 255 / 0.15);
	}
</style>
