---
/**
 * @component Link
 *
 * @description
 * Link 组件是一个增强的链接组件，提供了丰富的样式变体和动画效果。
 * 自包含实现：BEM 命名 + 原生 CSS，不依赖 cn() 与 cosy: 工具类。
 *
 * @usage
 * 基本用法：
 * ```astro
 * <Link href="/about">关于我们</Link>
 * ```
 *
 * 外部链接：
 * ```astro
 * <Link href="https://example.com" external>访问外部网站</Link>
 * ```
 *
 * 样式变体：
 * ```astro
 * <Link href="/signup" variant="primary">注册</Link>
 * <Link href="/docs" variant="text">查看文档</Link>
 * <Link href="/get-started" variant="cta">立即开始</Link>
 * <Link href="/preview" variant="ghost">预览</Link>
 * ```
 *
 * 按钮风格：
 * ```astro
 * <Link href="/signup" btn>按钮链接</Link>
 * <Link href="/ghost" btn ghost>幽灵按钮</Link>
 * ```
 *
 * @props
 * @prop {boolean} [active=false] - 是否为激活状态
 * @prop {'left'|'center'|'right'} [align] - 对齐方式
 * @prop {'none'|'hover-lift'|'hover-glow'|'hover-scale'} [animation='none'] - 动画效果
 * @prop {boolean} [block=false] - 是否为块级显示
 * @prop {boolean} [btn=false] - 是否启用按钮风格
 * @prop {boolean} [circle=false] - 是否为圆形按钮（需配合 btn）
 * @prop {string} [class] - 自定义 CSS 类名
 * @prop {'primary'|'secondary'|'accent'|'info'|'success'|'warning'|'error'} [color] - 按钮颜色（配合 btn）
 * @prop {boolean} [debug=false] - 是否显示调试边框
 * @prop {boolean} [external=false] - 是否为外部链接，自动新窗口打开
 * @prop {boolean} [fullWidth=false] - 是否占满宽度
 * @prop {boolean} [ghost=false] - 是否为幽灵按钮（配合 btn）
 * @prop {string} href - 链接地址（必需）
 * @prop {string} [icon] - 图标名称
 * @prop {string} [hoverImage] - 悬停时显示的图片
 * @prop {string} [hoverImageAlt] - 悬停图片 alt 文本
 * @prop {'previous'|'next'} [navigationType] - 导航类型（配合 navigation 变体）
 * @prop {boolean} [noUnderline=true] - 是否移除下划线
 * @prop {'none'|'sm'|'md'|'lg'|'xl'|'full'} [rounded='none'] - 圆角大小
 * @prop {'sm'|'md'|'lg'} [size='md'] - 尺寸大小
 * @prop {'default'|'primary'|'secondary'|'text'|'cta'|'ghost'|'light'|'navigation'|'github'} [variant='default'] - 样式变体
 */

import * as Icons from "../icons";
import { ChevronLeftIcon, ChevronRightIcon, GithubIcon } from "../icons";
import Image from "./Image.astro";

export type LinkSize = "sm" | "md" | "lg";
export type LinkVariant ="default" | "primary" | "secondary" | "text" | "cta" | "ghost" | "light" | "navigation" | "github";
export type LinkAnimation = "none" | "hover-lift" | "hover-glow" | "hover-scale";

export interface ILinkProps {
	href: string;
	external?: boolean;
	block?: boolean;
	class?: string;
	variant?: LinkVariant;
	animation?: LinkAnimation;
	size?: LinkSize;
	debug?: boolean;
	btn?: boolean;
	circle?: boolean;
	ghost?: boolean;
	noUnderline?: boolean;
	rounded?: "none" | "sm" | "md" | "lg" | "xl" | "full";
	fullWidth?: boolean;
	color?: "primary" | "secondary" | "accent" | "info" | "success" | "warning" | "error";
	align?: "left" | "center" | "right";
	active?: boolean;
	navigationType?: "previous" | "next";
	icon?: string;
	hoverImage?: string;
	hoverImageAlt?: string;
	[Key: string]: any;
}

const props = Astro.props as ILinkProps;

const {
	href,
	external = false,
	block = false,
	variant = "default",
	animation = "none",
	size = "md",
	debug = false,
	btn = false,
	circle = false,
	ghost = false,
	noUnderline = true,
	rounded = "none",
	fullWidth = false,
	color,
	align,
	active = false,
	navigationType,
	icon,
	hoverImage,
	hoverImageAlt,
	class: className = "",
} = props;

const IconComponent = icon ? (Icons as any)[icon] : null;

/* 类名组合 */
const linkClasses = [
	"cosy-link",
	block ? "cosy-link--block" : "",
	hoverImage ? "cosy-link--group" : "",
	icon ? "cosy-link--has-icon" : "",
	`cosy-link--variant-${variant}`,
	btn ? "cosy-link--btn" : "",
	btn && ghost ? "cosy-link--btn-ghost" : "",
	btn && color ? `cosy-link--btn-color-${color}` : "",
	btn && fullWidth ? "cosy-link--btn-block" : "",
	btn && circle ? "cosy-link--btn-circle" : "",
	!btn && fullWidth ? "cosy-link--full" : "",
	!btn && noUnderline ? "cosy-link--no-underline" : "",
	btn ? `cosy-link--btn-${size}` : `cosy-link--size-${size}`,
	!btn && rounded !== "none" ? `cosy-link--rounded-${rounded}` : "",
	align ? `cosy-link--align-${align}` : "",
	active ? "cosy-link--active" : "",
	debug ? "cosy-link--debug" : "",
	animation !== "none" ? `cosy-link--anim-${animation}` : "",
	className,
]
	.filter(Boolean)
	.join(" ");

const targetAttrs = external
	? { target: "_blank", rel: "noopener noreferrer" }
	: {};
---

<a href={href} class={linkClasses} {...targetAttrs} {...Astro.props}>
	{navigationType === "previous" && <ChevronLeftIcon class="cosy-link__icon" />}
	{variant === "github" && <GithubIcon class="cosy-link__icon" />}
	{IconComponent && <IconComponent class="cosy-link__icon" />}
	<slot />
	{navigationType === "next" && <ChevronRightIcon class="cosy-link__icon" />}

	{
		hoverImage && (
			<div class="cosy-link__tooltip">
				<div class="cosy-link__tooltip-card">
					<Image
						src={hoverImage}
						alt={hoverImageAlt || "悬停图片"}
						width={200}
						height={200}
						objectFit="contain"
						rounded="lg"
						shadow="none"
						border="none"
						hover="none"
						transition="none"
						loading="eager"
						showPlaceholder={false}
						showError={true}
					/>
				</div>
				<div class="cosy-link__tooltip-arrow" />
			</div>
		)
	}
</a>

<style is:global>
    /* Link - 原生 CSS 实现（daisyui corporate 主题色） */
    .cosy-link {
        --cosy-link-primary: var(--color-primary, #4b6bfb);
        --cosy-link-secondary: var(--color-secondary, #7b92b2);
        --cosy-link-accent: var(--color-accent, #67baa3);
        --cosy-link-info: var(--color-info, #2563eb);
        --cosy-link-success: var(--color-success, #16a34a);
        --cosy-link-warning: var(--color-warning, #d97706);
        --cosy-link-error: var(--color-error, #dc2626);
        --cosy-link-base-content: var(--color-base-content, #1d1d1d);
        --cosy-link-base-100: var(--color-base-100, #ffffff);
        --cosy-link-base-300: var(--color-base-300, #d7d7d7);

        display: inline-flex;
        align-items: center;
        cursor: pointer;
        transition: all 0.2s ease;
        color: var(--cosy-link-base-content);
        text-decoration: none;
    }
    .cosy-link--block { display: flex; width: 100%; }
    .cosy-link--group { position: relative; }
    .cosy-link--has-icon { gap: 0.5rem; }
    .cosy-link__icon { flex-shrink: 0; }

    /* 尺寸（非按钮） */
    .cosy-link--size-sm { font-size: 0.875rem; }
    .cosy-link--size-md { font-size: 1rem; }
    .cosy-link--size-lg { font-size: 1.125rem; }

    /* 变体颜色 */
    .cosy-link--variant-default { color: var(--cosy-link-base-content); }
    .cosy-link--variant-default:hover { opacity: 0.9; }
    .cosy-link--variant-primary { color: var(--cosy-link-primary); }
    .cosy-link--variant-secondary { color: var(--cosy-link-secondary); }
    .cosy-link--variant-text { color: var(--cosy-link-primary); }
    .cosy-link--variant-cta { color: var(--cosy-link-accent); font-weight: 500; }
    .cosy-link--variant-ghost { color: var(--cosy-link-base-content); }
    .cosy-link--variant-ghost:hover { opacity: 0.8; }
    .cosy-link--variant-light { color: #fff; font-weight: 500; }
    .cosy-link--variant-light:hover { opacity: 0.9; }
    .cosy-link--variant-navigation {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
        background: var(--cosy-link-base-100);
        border: 1px solid var(--cosy-link-base-300);
        border-radius: 0.5rem;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        font-weight: 500;
        color: var(--cosy-link-base-content);
        transition: all 0.3s ease;
    }
    .cosy-link--variant-navigation:hover {
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transform: translateY(-0.25rem) scale(1.01);
    }
    .cosy-link--variant-github {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--cosy-link-base-content);
        font-weight: 500;
    }
    .cosy-link--variant-github:hover { opacity: 0.8; }

    /* 无下划线 */
    .cosy-link--no-underline { text-decoration: none; }
    .cosy-link--no-underline:hover { text-decoration: none; }
    .cosy-link--full { width: 100%; }

    /* 按钮风格 */
    .cosy-link--btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-weight: 500;
        border-radius: 0.5rem;
        border: 1px solid transparent;
        text-decoration: none;
    }
    .cosy-link--btn-sm { padding: 0.375rem 1rem; font-size: 0.875rem; }
    .cosy-link--btn-md { padding: 0.5rem 1.25rem; font-size: 1rem; }
    .cosy-link--btn-lg { padding: 0.625rem 1.5rem; font-size: 1.125rem; }
    .cosy-link--btn-color-primary { background: var(--cosy-link-primary); color: var(--color-primary-content, #fff); }
    .cosy-link--btn-color-secondary { background: var(--cosy-link-secondary); color: var(--color-secondary-content, #fff); }
    .cosy-link--btn-color-accent { background: var(--cosy-link-accent); color: var(--color-accent-content, #fff); }
    .cosy-link--btn-color-info { background: var(--cosy-link-info); color: var(--color-info-content, #fff); }
    .cosy-link--btn-color-success { background: var(--cosy-link-success); color: var(--color-success-content, #fff); }
    .cosy-link--btn-color-warning { background: var(--cosy-link-warning); color: var(--color-warning-content, #fff); }
    .cosy-link--btn-color-error { background: var(--cosy-link-error); color: var(--color-error-content, #fff); }
    .cosy-link--btn-ghost {
        background: transparent;
        color: var(--cosy-link-base-content);
    }
    .cosy-link--btn-ghost:hover {
        background: color-mix(in srgb, var(--cosy-link-base-content) 10%, transparent);
    }
    .cosy-link--btn-block { display: flex; width: 100%; }
    .cosy-link--btn-circle {
        width: 2.5rem;
        height: 2.5rem;
        padding: 0;
        border-radius: 9999px;
    }

    /* 圆角（非按钮） */
    .cosy-link--rounded-sm { border-radius: 0.125rem; }
    .cosy-link--rounded-md { border-radius: 0.375rem; }
    .cosy-link--rounded-lg { border-radius: 0.5rem; }
    .cosy-link--rounded-xl { border-radius: 0.75rem; }
    .cosy-link--rounded-full { border-radius: 9999px; }

    /* 对齐 */
    .cosy-link--align-left { justify-content: flex-start; text-align: left; }
    .cosy-link--align-center { justify-content: center; text-align: center; }
    .cosy-link--align-right { justify-content: flex-end; text-align: right; }

    /* 状态 */
    .cosy-link--active { font-weight: 700; }
    .cosy-link--debug { border: 1px dashed #dc2626; }

    /* 动画 */
    .cosy-link--anim-hover-lift:hover { transform: translateY(-0.125rem); }
    .cosy-link--anim-hover-glow:hover { filter: brightness(1.25); }
    .cosy-link--anim-hover-scale:hover { transform: scale(1.05); }

    /* 悬停图片 tooltip */
    .cosy-link__tooltip {
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        margin-bottom: 0.5rem;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
        z-index: 50;
        min-width: 14rem;
    }
    .cosy-link--group:hover .cosy-link__tooltip { opacity: 1; }
    .cosy-link__tooltip-card {
        background: var(--color-base-100, #fff);
        border-radius: 0.5rem;
        box-shadow: 0 10px 15px rgba(0,0,0,0.1);
        padding: 0.75rem;
        border: 1px solid var(--color-base-200, #e9e9e9);
        min-width: 14rem;
    }
    .cosy-link__tooltip-arrow {
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 0;
        border-left: 0.25rem solid transparent;
        border-right: 0.25rem solid transparent;
        border-top: 0.25rem solid #fff;
    }
</style>
