---
/**
 * @component ApplePhone
 *
 * @description
 * ApplePhone 组件模拟 iPhone 设备外观，包含状态栏、时间显示和设备边框。
 * 适用于创建移动应用界面原型或展示移动端设计效果。
 *
 * @usage
 * 基本用法：
 * ```astro
 * <ApplePhone title="我的应用">
 *   <div>应用内容</div>
 * </ApplePhone>
 * ```
 *
 * 自定义高度和背景色：
 * ```astro
 * <ApplePhone height="xl" backgroundColor="primary/10">
 *   <div>应用内容</div>
 * </ApplePhone>
 * ```
 *
 * 不显示边框：
 * ```astro
 * <ApplePhone showFrame={false}>
 *   <div>应用内容</div>
 * </ApplePhone>
 * ```
 *
 * @props
 * @prop {'sm'|'md'|'lg'|'xl'|'2xl'|'3xl'|'4xl'|'5xl'} [height='lg'] - 窗口高度选项
 * @prop {string} [title] - 窗口标题
 * @prop {boolean} [withShadow=true] - 是否显示阴影
 * @prop {boolean} [showFrame=true] - 是否显示 iPhone 边框
 * @prop {BackgroundColor} [backgroundColor] - 内容区域背景色
 *
 * @slots
 * @slot default - 主要内容区域
 */

import type { HTMLAttributes } from "astro/types";
import type { BackgroundColor } from "../src/common/backgrounds";
import AlertDialog from "./AlertDialog.astro";
import Container from "./Container.astro";
import Image from "./Image.astro";
import { IPhoneBatteryIcon, IPhoneSignalIcon, IPhoneWifiIcon } from "./icons";

/* ===== 常量（内联自 apple-phone/constants） ===== */
const IPHONE_FRAME_WIDTH = 1339;
const IPHONE_FRAME_HEIGHT = 2716;
const IPHONE_FRAME_STATUS_BAR_TOP = 115;
const IPHONE_FRAME_STATUS_BAR_HEIGHT = 110;
const MAIN_CONTENT_WIDTH_ASPECT_RATIO = 1179 / IPHONE_FRAME_WIDTH;
const MAIN_CONTENT_HEIGHT_ASPECT_RATIO = 2556 / IPHONE_FRAME_HEIGHT;
const IPHONE_FRAME_STATUS_BAR_HEIGHT_ASPECT_RATIO =
	IPHONE_FRAME_STATUS_BAR_HEIGHT / IPHONE_FRAME_HEIGHT;
const IPHONE_FRAME_STATUS_BAR_TOP_ASPECT_RATIO =
	IPHONE_FRAME_STATUS_BAR_TOP / IPHONE_FRAME_HEIGHT;

/** 高度值映射（px） */
const heightValues = {
	sm: 256,
	md: 320,
	lg: 384,
	xl: 480,
	"2xl": 560,
	"3xl": 640,
	"4xl": 720,
	"5xl": 800,
} as const;

export type ApplePhoneHeight = keyof typeof heightValues;

export interface IApplePhoneProps
	extends Omit<HTMLAttributes<"div">, "class"> {
	height?: ApplePhoneHeight;
	title?: string;
	withShadow?: boolean;
	showFrame?: boolean;
	backgroundColor?: BackgroundColor;
	class?: string;
}

// iPhone 边框图片
import iphoneFrame from "../src/components/apple-phone/assets/iPhone14ProDeepPurplePortrait.png";

const {
	height = "lg",
	showFrame = true,
	backgroundColor = undefined,
	class: className = "",
} = Astro.props as IApplePhoneProps;

// 计算缩放比例
const currentHeight = heightValues[height];
const scaleRatio = currentHeight / 500;

// 唯一 ID
const uniqueId = `apple-phone-${Math.random().toString(36).slice(2, 11)}`;

// 缩放后的字体/图标尺寸
const scaledFontSize = `${14 * scaleRatio}px`;
const scaledIconSize = `${15 * scaleRatio}px`;

const rootClass = ["cosy-apple-phone", className].filter(Boolean).join(" ");
---

<div
	class={rootClass}
	style={`aspect-ratio: ${IPHONE_FRAME_WIDTH}/${IPHONE_FRAME_HEIGHT}; height: ${currentHeight}px;`}>
	{/* iPhone 边框（底层） */}
	{showFrame && (
		<div class="cosy-apple-phone__frame">
			<Image src={iphoneFrame} alt="iPhone frame" />
		</div>
	)}

	{/* 顶部状态栏 */}
	<div
		class="cosy-apple-phone__status-bar"
		style={`top: ${IPHONE_FRAME_STATUS_BAR_TOP_ASPECT_RATIO * 100}%; height: ${IPHONE_FRAME_STATUS_BAR_HEIGHT_ASPECT_RATIO * 100}%; width: ${MAIN_CONTENT_WIDTH_ASPECT_RATIO * 100}%; left: 50%; transform: translate(-50%, 0); padding-left: 5%; padding-right: 5%;`}>
		<div class="cosy-apple-phone__status-inner">
			<span
				class="cosy-apple-phone__time"
				data-time-text
				style={`font-size: ${scaledFontSize}; line-height: 1; transition: font-size 0.2s ease;`}>
				12:00
			</span>
			<div class="cosy-apple-phone__icons">
				<div
					class="cosy-apple-phone__icon-wrap"
					style={`width: ${scaledIconSize}; height: ${scaledIconSize}; min-width: 0; min-height: 0;`}>
					<IPhoneSignalIcon class="cosy-apple-phone__status-icon" />
				</div>
				<div
					class="cosy-apple-phone__icon-wrap"
					style={`width: ${scaledIconSize}; height: ${scaledIconSize}; min-width: 0; min-height: 0;`}>
					<IPhoneWifiIcon class="cosy-apple-phone__status-icon" />
				</div>
				<div
					class="cosy-apple-phone__icon-wrap"
					style={`width: ${scaledIconSize}; height: ${scaledIconSize}; min-width: 0; min-height: 0;`}>
					<IPhoneBatteryIcon class="cosy-apple-phone__status-icon" />
				</div>
			</div>
		</div>
	</div>

	{/* 内容区域 */}
	<div
		class="cosy-apple-phone__content"
		style={`width: ${MAIN_CONTENT_WIDTH_ASPECT_RATIO * 100}%; height: ${MAIN_CONTENT_HEIGHT_ASPECT_RATIO * 100}%; left: 50%; top: 50%; transform: translate(-50%, -50%);`}>
		<Container
			rounded="lg"
			height="full"
			padding="none"
			class="cosy-apple-phone__scroll"
			background={backgroundColor || "accent/90"}>
			<slot />
		</Container>
	</div>

	{/* iPhone 边框（上层，盖住内容四角） */}
	{showFrame && (
		<div class="cosy-apple-phone__frame cosy-apple-phone__frame--top">
			<Image src={iphoneFrame} alt="iPhone frame" />
		</div>
	)}
</div>

<AlertDialog id={`${uniqueId}-alert`} message="" />

<style is:global>
	/* ApplePhone - 原生 CSS 实现 */
	.cosy-apple-phone {
		position: relative;
		margin-left: auto;
		margin-right: auto;
	}

	.cosy-apple-phone__frame {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 10;
		pointer-events: none;
		max-width: 100%;
		max-height: 100%;
	}
	.cosy-apple-phone__frame--top {
		z-index: 50;
	}
	.cosy-apple-phone__frame img {
		width: 100%;
		height: 100%;
	}

	.cosy-apple-phone__status-bar {
		position: absolute;
		width: 100%;
		z-index: 50;
	}

	.cosy-apple-phone__status-inner {
		display: flex;
		align-items: center;
		height: 100%;
		justify-content: space-between;
	}

	.cosy-apple-phone__time {
		font-weight: 500;
	}

	.cosy-apple-phone__icons {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		height: 100%;
	}

	.cosy-apple-phone__icon-wrap {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.cosy-apple-phone__status-icon {
		color: #000000;
		fill: currentColor;
	}
	.cosy-apple-phone__status-icon svg {
		width: 100%;
		height: 100%;
	}

	.cosy-apple-phone__content {
		position: absolute;
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	.cosy-apple-phone__scroll {
		height: 100%;
		overflow-y: auto;
		overscroll-behavior-y: contain;
	}
</style>

<script>
	function updateTime() {
		const now = new Date();
		const hours = now.getHours().toString().padStart(2, "0");
		const minutes = now.getMinutes().toString().padStart(2, "0");
		return `${hours}:${minutes}`;
	}

	function updateStatusBarTime() {
		const timeElements = document.querySelectorAll("[data-time-text]");
		timeElements.forEach((element) => {
			(element as HTMLElement).textContent = updateTime();
		});
	}

	document.addEventListener("DOMContentLoaded", () => {
		updateStatusBarTime();
		setInterval(updateStatusBarTime, 60000);
	});
</script>
