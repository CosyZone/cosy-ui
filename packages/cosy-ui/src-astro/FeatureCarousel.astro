---
/**
 * @component FeatureCarousel
 * @description 特性轮播组件，横向滑动显示多个特性卡片
 * @example
 * <FeatureCarousel
 *   features={[
 *     {
 *       title: "性能和电池续航",
 *       description: "跑得快,跑得久。",
 *       background: "linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%)",
 *       image: "https://example.com/image.jpg",
 *       textColor: "white"
 *     }
 *   ]}
 * />
 */
import Button from "./Button.astro";
import { ChevronLeftIcon, ChevronRightIcon } from "./icons";
import type { ImageSource } from "./Image.astro";
import FeatureCard from "./FeatureCard.astro";

export interface FeatureCarouselFeature {
	title: string;
	description: string;
	background: string;
	image?: ImageSource;
	textColor?: "white" | "dark";
}

export interface FeatureCarouselProps {
	features: FeatureCarouselFeature[];
	class?: string;
}

const { features, class: className = "" } = Astro.props as FeatureCarouselProps;

const carouselClass = ["cosy-feature-carousel", className].filter(Boolean).join(" ");
---

<div class={carouselClass}>
	<div class="cosy-feature-carousel__track" id="feature-cards">
		{
			features.map((feature) => (
				<FeatureCard
					title={feature.title}
					description={feature.description}
					background={feature.background}
					image={feature.image}
					textColor={feature.textColor}
				/>
			))
		}
	</div>

	<div class="cosy-feature-carousel__nav">
		<Button
			id="prev-btn"
			variant="neutral"
			shape="circle"
			size="lg"
			aria-label="向左滚动">
			<ChevronLeftIcon size="20px" />
		</Button>
		<Button
			id="next-btn"
			variant="neutral"
			shape="circle"
			size="lg"
			aria-label="向右滚动">
			<ChevronRightIcon size="20px" />
		</Button>
	</div>
</div>

<script>
    const SCROLL_DISTANCE = 400;

    function initFeatureCarousel() {
        const cardsContainerEl = document.getElementById('feature-cards') as HTMLElement | null;
        const prevBtnEl = document.getElementById('prev-btn') as HTMLButtonElement | null;
        const nextBtnEl = document.getElementById('next-btn') as HTMLButtonElement | null;
        if (!cardsContainerEl || !prevBtnEl || !nextBtnEl) return;

        const cardsContainer: HTMLElement = cardsContainerEl;
        const prevBtn: HTMLButtonElement = prevBtnEl;
        const nextBtn: HTMLButtonElement = nextBtnEl;

        function updateButtonStates() {
            const { scrollLeft, scrollWidth, clientWidth } = cardsContainer;
            const isAtStart = scrollLeft <= 0;
            prevBtn.disabled = isAtStart;
            prevBtn.classList.toggle('cosy-feature-carousel__nav-btn--disabled', isAtStart);

            const isAtEnd = scrollLeft >= scrollWidth - clientWidth - 1;
            nextBtn.disabled = isAtEnd;
            nextBtn.classList.toggle('cosy-feature-carousel__nav-btn--disabled', isAtEnd);
        }

        function onPrev() {
            cardsContainer.scrollBy({ left: -SCROLL_DISTANCE, behavior: 'smooth' });
        }
        function onNext() {
            cardsContainer.scrollBy({ left: SCROLL_DISTANCE, behavior: 'smooth' });
        }

        prevBtn.removeEventListener('click', onPrev);
        nextBtn.removeEventListener('click', onNext);
        cardsContainer.removeEventListener('scroll', updateButtonStates);

        prevBtn.addEventListener('click', onPrev);
        nextBtn.addEventListener('click', onNext);
        cardsContainer.addEventListener('scroll', updateButtonStates);
        updateButtonStates();
    }

    document.addEventListener('astro:page-load', initFeatureCarousel);
    document.addEventListener('astro:after-swap', initFeatureCarousel);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initFeatureCarousel);
    } else {
        initFeatureCarousel();
    }
</script>

<style is:global>
    /* FeatureCarousel - 原生 CSS 实现（corporate 主题色） */
    .cosy-feature-carousel {
        position: relative;
    }
    .cosy-feature-carousel__track {
        display: flex;
        gap: 1rem;
        padding: 4rem 1rem;
        overflow-x: auto;
        scroll-behavior: smooth;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .cosy-feature-carousel__track::-webkit-scrollbar {
        display: none;
    }
    .cosy-feature-carousel__nav {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        margin: 1rem 0;
    }
    .cosy-feature-carousel__nav-btn--disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>
