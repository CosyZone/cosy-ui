---
/**
 * @component Carousel
 *
 * @description
 * Carousel 组件是基于锚点的图片轮播，支持左右导航切换，同页多实例可通过 idPrefix 隔离。
 *
 * @usage
 * 基本用法：
 * ```astro
 * <Carousel
 *   items={[
 *     { src: '/img1.jpg', alt: '第一张' },
 *     { src: '/img2.jpg', alt: '第二张' },
 *   ]}
 * />
 * ```
 *
 * 隐藏导航按钮：
 * ```astro
 * <Carousel items={items} showNav={false} />
 * ```
 *
 * @props
 * @prop {ICarouselItem[]} items - 轮播项列表
 * @prop {string} [idPrefix='carousel'] - 锚点 id 前缀，确保同页多实例不冲突
 * @prop {string} [navButtonClass] - 自定义导航按钮类名（留空使用默认样式）
 * @prop {boolean} [showNav=true] - 是否显示上一页/下一页导航按钮
 * @prop {string} [id] - 根元素 id（可选）
 * @prop {string} [class] - 追加的类名
 *
 * @slots
 * @slot default - 额外内容
 */

import type { HTMLAttributes } from "astro/types";

export interface ICarouselItem {
	/** 唯一标识（用于生成锚点 id） */
	id?: string;
	/** 图片地址 */
	src: string;
	/** 图片描述（可选） */
	alt?: string;
}

export interface ICarouselProps
	extends Omit<HTMLAttributes<"div">, "class"> {
	/** 轮播项列表 */
	items: ICarouselItem[];
	/** 锚点 id 前缀，确保同页多实例不冲突 @default 'carousel' */
	idPrefix?: string;
	/** 自定义导航按钮类名（留空使用默认 BEM 样式） */
	navButtonClass?: string;
	/** 是否显示上一页/下一页导航按钮 @default true */
	showNav?: boolean;
	/** 根元素 id（可选） */
	id?: string;
	/** 追加的类名 */
	class?: string;
}

const {
	items = [],
	idPrefix = "carousel",
	navButtonClass = "",
	showNav = true,
	id,
	class: className = "",
	...rest
} = Astro.props as ICarouselProps;

const slides = items.map((item, index) => ({
	id: item.id ?? `${idPrefix}-slide-${index + 1}`,
	src: item.src,
	alt: item.alt ?? "",
}));

function getPrevIndex(current: number, total: number) {
	return (current - 1 + total) % total;
}

function getNextIndex(current: number, total: number) {
	return (current + 1) % total;
}

const rootClass = ["cosy-carousel", className].filter(Boolean).join(" ");
---

<div id={id} class={rootClass} {...rest}>
	{
		slides.map((slide, idx) => (
			<div id={slide.id} class="cosy-carousel__item">
				<img src={slide.src} alt={slide.alt} class="cosy-carousel__img" />
				{showNav && (
					<div class="cosy-carousel__nav">
						<a
							href={`#${slides[getPrevIndex(idx, slides.length)].id}`}
							class={navButtonClass || "cosy-carousel__nav-btn"}
							aria-label="Previous slide">
							&#10094;
						</a>
						<a
							href={`#${slides[getNextIndex(idx, slides.length)].id}`}
							class={navButtonClass || "cosy-carousel__nav-btn"}
							aria-label="Next slide">
							&#10095;
						</a>
					</div>
				)}
			</div>
		))
	}
	<slot />
</div>

<style is:global>
	/* Carousel - 原生 CSS 实现 */
	.cosy-carousel {
		display: block;
		position: relative;
		width: 100%;
		overflow: hidden;
	}

	.cosy-carousel__item {
		position: relative;
		width: 100%;
		scroll-snap-align: start;
	}

	.cosy-carousel__img {
		display: block;
		width: 100%;
		height: auto;
	}

	.cosy-carousel__nav {
		position: absolute;
		left: 1.25rem;
		right: 1.25rem;
		top: 50%;
		display: flex;
		transform: translateY(-50%);
		justify-content: space-between;
	}

	.cosy-carousel__nav-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 9999px;
		background: rgba(0, 0, 0, 0.35);
		color: #fff;
		font-size: 1.25rem;
		line-height: 1;
		text-decoration: none;
		transition: background-color 0.15s ease;
	}

	.cosy-carousel__nav-btn:hover {
		background: rgba(0, 0, 0, 0.55);
	}
</style>
