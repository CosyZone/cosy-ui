---
/**
 * @component EmptyState
 * @description 一个用于表示空状态的组件，通常在列表、搜索结果或任何需要数据的区域为空时使用。
 *
 * @usage
 * ```astro
 * <EmptyState
 *   icon="UsersIcon"
 *   title="没有找到用户"
 *   description="尝试更改筛选条件或创建一个新用户。"
 * >
 *   <Button>创建用户</Button>
 * </EmptyState>
 * ```
 *
 * @props
 * - icon?: string - 在标题上方显示的图标名称。
 * - title?: string - 主标题，用于描述空状态。
 * - description?: string - 对空状态的详细描述。
 *
 * @slots
 * - default - 用于放置操作按钮，如"创建"或"返回"。
 */
import * as Icons from "./icons";
import type { HTMLAttributes } from "astro/types";

export const iconNames = [
	"TwitterIcon", "UserIcon", "WarningIcon", "XCircle", "InfoIcon",
	"LinkIcon", "LinkedinIcon", "MenuIcon", "RefreshIcon", "SearchIcon",
	"SuccessIcon", "SunCloudyIcon", "AlertTriangle", "CalendarIcon", "CheckCircle",
	"CheckIcon", "ClipboardIcon", "CloseIcon", "CodeIcon", "DeleteIcon",
	"ErrorIcon", "GithubIcon", "InfoCircle", "InboxArchive", "SettingsIcon",
	"ChevronDownIcon", "HomeIcon", "DashboardIcon", "ChartIcon", "DocumentIcon",
	"NotificationIcon", "UsersIcon", "MessageIcon", "MailIcon", "FolderIcon",
	"StarIcon", "HeartIcon", "SaveIcon", "EditIcon", "ToolsIcon",
	"WalletIcon", "ReportIcon", "SecurityIcon", "UploadIcon", "DownloadIcon",
	"LogOut", "AppStoreIcon", "WebsiteIcon",
];

export type IconName = (typeof iconNames)[number];

export interface EmptyStateProps extends HTMLAttributes<"div"> {
	/** 主标题 */
	title?: string;
	/** 详细描述 */
	description?: string;
	/** 图标名称 */
	icon?: IconName;
}

const { title, description, icon, ...rest } = Astro.props;

const iconMap: Record<string, any> = {
	TwitterIcon: Icons.TwitterIcon,
	UserIcon: Icons.UserIcon,
	WarningIcon: Icons.WarningIcon,
	XCircle: Icons.XCircle,
	InfoIcon: Icons.InfoIcon,
	LinkIcon: Icons.LinkIcon,
	LinkedinIcon: Icons.LinkedinIcon,
	MenuIcon: Icons.MenuIcon,
	RefreshIcon: Icons.RefreshIcon,
	SearchIcon: Icons.SearchIcon,
	SuccessIcon: Icons.SuccessIcon,
	SunCloudyIcon: Icons.SunCloudyIcon,
	AlertTriangle: Icons.AlertTriangle,
	CalendarIcon: Icons.CalendarIcon,
	CheckCircle: Icons.CheckCircle,
	CheckIcon: Icons.CheckIcon,
	ClipboardIcon: Icons.ClipboardIcon,
	CloseIcon: Icons.CloseIcon,
	CodeIcon: Icons.CodeIcon,
	DeleteIcon: Icons.DeleteIcon,
	ErrorIcon: Icons.ErrorIcon,
	GithubIcon: Icons.GithubIcon,
	InfoCircle: Icons.InfoCircle,
	InboxArchive: Icons.InboxArchive,
	SettingsIcon: Icons.SettingsIcon,
	ChevronDownIcon: Icons.ChevronDownIcon,
	HomeIcon: Icons.HomeIcon,
	DashboardIcon: Icons.DashboardIcon,
	ChartIcon: Icons.ChartIcon,
	DocumentIcon: Icons.DocumentIcon,
	NotificationIcon: Icons.NotificationIcon,
	UsersIcon: Icons.UsersIcon,
	MessageIcon: Icons.MessageIcon,
	MailIcon: Icons.MailIcon,
	FolderIcon: Icons.FolderIcon,
	StarIcon: Icons.StarIcon,
	HeartIcon: Icons.HeartIcon,
	SaveIcon: Icons.SaveIcon,
	EditIcon: Icons.EditIcon,
	ToolsIcon: Icons.ToolsIcon,
	WalletIcon: Icons.WalletIcon,
	ReportIcon: Icons.ReportIcon,
	SecurityIcon: Icons.SecurityIcon,
	UploadIcon: Icons.UploadIcon,
	DownloadIcon: Icons.DownloadIcon,
	LogOut: Icons.LogOut,
	AppStoreIcon: Icons.AppStoreIcon,
	WebsiteIcon: Icons.WebsiteIcon,
};

const IconComponent =
	icon && iconMap[icon] ? iconMap[icon] : null;
---

<div class="cosy-empty-state" {...rest}>
	{
		IconComponent && (
			<IconComponent class="cosy-empty-state__icon" />
		)
	}
	{title && <h3 class="cosy-empty-state__title">{title}</h3>}
	{description && <p class="cosy-empty-state__description">{description}</p>}
	<div class="cosy-empty-state__action">
		<slot />
	</div>
</div>

<style is:global>
	/* EmptyState - 原生 CSS 实现（daisyui corporate 主题色） */
	.cosy-empty-state {
		--cosy-empty-base-content: #1d1d1d;

		box-sizing: border-box;
		text-align: center;
		padding: 4rem 1.5rem;
		color: var(--cosy-empty-base-content);
	}

	.cosy-empty-state__icon {
		display: block;
		margin-left: auto;
		margin-right: auto;
		width: 3rem;
		height: 3rem;
		color: var(--cosy-empty-base-content);
	}

	.cosy-empty-state__title {
		margin: 0.5rem 0 0;
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.cosy-empty-state__description {
		margin: 0.25rem 0 0;
		font-size: 0.875rem;
		color: color-mix(in srgb, var(--cosy-empty-base-content) 80%, transparent);
	}

	.cosy-empty-state__action {
		margin-top: 1.5rem;
		display: flex;
		justify-content: center;
		gap: 1rem;
	}
</style>
