---
/**
 * @component Login
 *
 * @description
 * Login 组件用于创建灵活且功能丰富的登录页面。支持多种登录方式、自定义样式和布局。
 * 自包含原生 CSS 实现，基于 BEM 类名（cosy-login），不再依赖 cn()/tailwind/daisyUI。
 *
 * @usage
 * 基本用法：
 * ```astro
 * <Login title="欢迎回来" />
 * ```
 *
 * 自定义登录方式：
 * ```astro
 * <Login
 *   title="登录到系统"
 *   subtitle="使用以下方式登录"
 *   socialLogins={['github', 'google']}
 *   showRememberMe={true}
 *   showForgotPassword={true}
 * />
 * ```
 *
 * 完全自定义：
 * ```astro
 * <Login
 *   title="企业登录"
 *   subtitle="安全登录到企业系统"
 *   logo="/path/to/logo.png"
 *   socialLogins={['github', 'google', 'wechat']}
 *   showRememberMe={true}
 *   showForgotPassword={true}
 *   customClass="my-login-page"
 * >
 *   <div slot="footer">
 *     自定义页脚内容
 *   </div>
 * </Login>
 * ```
 *
 * @props
 * @prop {string} [title="登录"] - 登录页标题
 * @prop {string} [subtitle] - 登录页副标题
 * @prop {string} [logo] - 登录页Logo图片路径
 * @prop {('github'|'google'|'wechat')[]} [socialLogins] - 社交登录方式列表
 * @prop {boolean} [showRememberMe=false] - 是否显示"记住我"选项
 * @prop {boolean} [showForgotPassword=false] - 是否显示"忘记密码"链接
 * @prop {string} [customClass] - 自定义CSS类名
 * @prop {string} [loginButtonText="登录"] - 登录按钮文本
 * @prop {string} [usernameLabel="用户名"] - 用户名输入框标签
 * @prop {string} [passwordLabel="密码"] - 密码输入框标签
 * @prop {string} [forgotPasswordText="忘记密码？"] - 忘记密码链接文本
 * @prop {string} [rememberMeText="记住我"] - 记住我选项文本
 * @prop {string} [dividerText="或"] - 社交登录分隔符文本
 *
 * @slots
 * @slot header - 页头自定义内容
 * @slot footer - 页脚自定义内容
 * @slot socialButtons - 自定义社交登录按钮
 */

import ChartIcon from './ChartIcon.astro';
import GithubIcon from './GithubIcon.astro';
import WechatIcon from './WechatIcon.astro';

export interface Props {
    title?: string;
    subtitle?: string;
    logo?: string;
    socialLogins?: ('github' | 'google' | 'wechat')[];
    showRememberMe?: boolean;
    showForgotPassword?: boolean;
    customClass?: string;
    loginButtonText?: string;
    usernameLabel?: string;
    passwordLabel?: string;
    forgotPasswordText?: string;
    rememberMeText?: string;
    dividerText?: string;
}

const {
    title = '登录',
    subtitle,
    logo,
    socialLogins = [],
    showRememberMe = false,
    showForgotPassword = false,
    customClass = '',
    loginButtonText = '登录',
    usernameLabel = '用户名',
    passwordLabel = '密码',
    forgotPasswordText = '忘记密码？',
    rememberMeText = '记住我',
    dividerText = '或',
} = Astro.props;

// 社交登录图标映射
const socialIcons = {
    github: GithubIcon,
    google: ChartIcon,
    wechat: WechatIcon,
};

// 社交登录按钮 provider 修饰符类名
const socialBtnModifiers = {
    github: 'cosy-login__social-btn--github',
    google: 'cosy-login__social-btn--google',
    wechat: 'cosy-login__social-btn--wechat',
};

// 社交按钮栅格列数修饰符（最多 3 列）
const socialColsModifier = `cosy-login__social-buttons--cols-${Math.min(socialLogins.length, 3)}`;

// 容器类名（BEM 根类 + customClass）
const containerClass = ['cosy-login', customClass].filter(Boolean).join(' ');
---

<div class={containerClass}>
    <div class="cosy-login__card">
        <!-- 头部区域 -->
        <div class="cosy-login__header">
            <slot name="header">
                {
                    logo && (
                        <img
                            class="cosy-login__logo"
                            src={logo}
                            alt="Logo"
                        />
                    )
                }
                <h2 class="cosy-login__title">
                    {title}
                </h2>
                {
                    subtitle && (
                        <p class="cosy-login__subtitle">
                            {subtitle}
                        </p>
                    )
                }
            </slot>
        </div>

        <!-- 登录表单 -->
        <form class="cosy-login__form">
            <div class="cosy-login__input-group">
                <div>
                    <label for="username" class="cosy-login__visually-hidden"
                        >{usernameLabel}</label
                    >
                    <input
                        id="username"
                        name="username"
                        type="text"
                        required
                        class="cosy-login__input"
                        placeholder={usernameLabel}
                    />
                </div>
                <div>
                    <label for="password" class="cosy-login__visually-hidden"
                        >{passwordLabel}</label
                    >
                    <input
                        id="password"
                        name="password"
                        type="password"
                        required
                        class="cosy-login__input"
                        placeholder={passwordLabel}
                    />
                </div>
            </div>

            <div class="cosy-login__options">
                {
                    showRememberMe && (
                        <div class="cosy-login__remember-me">
                            <input
                                id="remember-me"
                                name="remember-me"
                                type="checkbox"
                                class="cosy-login__checkbox"
                            />
                            <label
                                for="remember-me"
                                class="cosy-login__remember-me-label">
                                {rememberMeText}
                            </label>
                        </div>
                    )
                }

                {
                    showForgotPassword && (
                        <div class="cosy-login__forgot-password">
                            <a
                                href="#"
                                class="cosy-login__forgot-password-link">
                                {forgotPasswordText}
                            </a>
                        </div>
                    )
                }
            </div>

            <div>
                <button
                    type="submit"
                    class="cosy-login__submit-btn">
                    {loginButtonText}
                </button>
            </div>
        </form>

        <!-- 社交登录 -->
        {
            socialLogins.length > 0 && (
                <div class="cosy-login__social">
                    <div class="cosy-login__divider">
                        <span class="cosy-login__divider-line" />
                        <span class="cosy-login__divider-text">{dividerText}</span>
                        <span class="cosy-login__divider-line" />
                    </div>

                    <slot name="socialButtons">
                        <div class={`cosy-login__social-buttons ${socialColsModifier}`}>
                            {socialLogins.map((provider) => {
                                const Icon = socialIcons[provider];
                                return (
                                    <a
                                        href="#"
                                        class={`cosy-login__social-btn ${socialBtnModifiers[provider]}`}>
                                        <Icon class="cosy-login__social-btn-icon" />
                                    </a>
                                );
                            })}
                        </div>
                    </slot>
                </div>
            )
        }

        <!-- 页脚 -->
        <slot name="footer" />
    </div>
</div>

<style is:global>
    /* Login - 自包含原生 CSS 实现（BEM: cosy-login） */
    .cosy-login {
        --cosy-login-primary: #4b6bfb;
        --cosy-login-primary-focus: #3a56d4;
        --cosy-login-base-100: #ffffff;
        --cosy-login-base-200: #e9e9e9;
        --cosy-login-base-300: #d7d7d7;
        --cosy-login-base-content: #1d1d1d;

        box-sizing: border-box;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--cosy-login-base-200);
        padding-top: 3rem;
        padding-bottom: 3rem;
        padding-left: 1rem;
        padding-right: 1rem;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
            "Helvetica Neue", Arial, sans-serif;
        color: var(--cosy-login-base-content);
    }
    @media (min-width: 640px) {
        .cosy-login { padding-left: 1.5rem; padding-right: 1.5rem; }
    }
    @media (min-width: 1024px) {
        .cosy-login { padding-left: 2rem; padding-right: 2rem; }
    }
    .cosy-login *,
    .cosy-login *::before,
    .cosy-login *::after {
        box-sizing: border-box;
    }

    /* 卡片 */
    .cosy-login__card {
        width: 100%;
        max-width: 28rem;
        background-color: var(--cosy-login-base-100);
        padding: 2rem;
        border-radius: 0.5rem;
        box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1),
            0 8px 10px -6px rgb(0 0 0 / 0.1);
    }
    .cosy-login__card > * + * { margin-top: 2rem; }

    /* 头部 */
    .cosy-login__header { text-align: center; }
    .cosy-login__logo {
        margin-left: auto;
        margin-right: auto;
        height: 3rem;
        width: auto;
    }
    .cosy-login__title {
        margin: 1.5rem 0 0;
        font-size: 1.875rem;
        line-height: 2.25rem;
        font-weight: 800;
        color: var(--cosy-login-base-content);
    }
    .cosy-login__subtitle {
        margin: 0.5rem 0 0;
        font-size: 0.875rem;
        line-height: 1.25rem;
        color: color-mix(in srgb, var(--cosy-login-base-content) 60%, transparent);
    }

    /* 表单 */
    .cosy-login__form > * + * { margin-top: 1.5rem; }
    .cosy-login__input-group {
        border-radius: 0.375rem;
        box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    }
    .cosy-login__input-group > div + div { margin-top: -1px; }
    .cosy-login__input {
        appearance: none;
        position: relative;
        display: block;
        width: 100%;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--cosy-login-base-300);
        color: var(--cosy-login-base-content);
        font-size: 0.875rem;
        line-height: 1.25rem;
        border-radius: 0;
    }
    .cosy-login__input::placeholder {
        color: color-mix(in srgb, var(--cosy-login-base-content) 40%, transparent);
    }
    .cosy-login__input-group > div:first-child .cosy-login__input {
        border-top-left-radius: 0.375rem;
        border-top-right-radius: 0.375rem;
    }
    .cosy-login__input-group > div:last-child .cosy-login__input {
        border-bottom-left-radius: 0.375rem;
        border-bottom-right-radius: 0.375rem;
    }
    .cosy-login__input:focus {
        outline: none;
        z-index: 10;
        border-color: var(--cosy-login-primary);
        box-shadow: 0 0 0 1px var(--cosy-login-primary);
    }

    /* 辅助选项行 */
    .cosy-login__options {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .cosy-login__remember-me {
        display: flex;
        align-items: center;
    }
    .cosy-login__checkbox {
        height: 1rem;
        width: 1rem;
        color: var(--cosy-login-primary);
        border: 1px solid var(--cosy-login-base-300);
        border-radius: 0.25rem;
    }
    .cosy-login__checkbox:focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--cosy-login-primary);
    }
    .cosy-login__remember-me-label {
        margin-left: 0.5rem;
        display: block;
        font-size: 0.875rem;
        line-height: 1.25rem;
        color: var(--cosy-login-base-content);
    }
    .cosy-login__forgot-password { font-size: 0.875rem; line-height: 1.25rem; }
    .cosy-login__forgot-password-link {
        font-weight: 500;
        color: var(--cosy-login-primary);
        text-decoration: none;
    }
    .cosy-login__forgot-password-link:hover {
        color: var(--cosy-login-primary-focus);
    }

    /* 提交按钮 */
    .cosy-login__submit-btn {
        position: relative;
        width: 100%;
        display: flex;
        justify-content: center;
        padding: 0.5rem 1rem;
        border: 1px solid transparent;
        border-radius: 0.375rem;
        font-size: 0.875rem;
        line-height: 1.25rem;
        font-weight: 500;
        color: #fff;
        background-color: var(--cosy-login-primary);
        cursor: pointer;
        transition: background-color 0.15s ease;
    }
    .cosy-login__submit-btn:hover { background-color: var(--cosy-login-primary-focus); }
    .cosy-login__submit-btn:focus {
        outline: none;
        box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--cosy-login-primary);
    }

    /* 社交登录区 */
    .cosy-login__social { margin-top: 1.5rem; }
    .cosy-login__divider {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .cosy-login__divider-line {
        flex: 1 1 0%;
        border-top: 1px solid var(--cosy-login-base-300);
    }
    .cosy-login__divider-text {
        font-size: 0.875rem;
        line-height: 1.25rem;
        padding: 0 0.5rem;
        background-color: var(--cosy-login-base-100);
        color: color-mix(in srgb, var(--cosy-login-base-content) 60%, transparent);
    }
    .cosy-login__social-buttons {
        margin-top: 1.5rem;
        display: grid;
        gap: 0.75rem;
    }
    .cosy-login__social-buttons--cols-1 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
    .cosy-login__social-buttons--cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cosy-login__social-buttons--cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .cosy-login__social-btn {
        width: 100%;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        font-size: 0.875rem;
        line-height: 1.25rem;
        font-weight: 500;
        color: #fff;
        text-decoration: none;
        transition: background-color 0.15s ease;
    }
    .cosy-login__social-btn-icon {
        width: 1.25rem;
        height: 1.25rem;
    }
    .cosy-login__social-btn--github { background-color: #1f2937; }
    .cosy-login__social-btn--github:hover { background-color: #111827; }
    .cosy-login__social-btn--google { background-color: #ef4444; }
    .cosy-login__social-btn--google:hover { background-color: #dc2626; }
    .cosy-login__social-btn--wechat { background-color: #22c55e; }
    .cosy-login__social-btn--wechat:hover { background-color: #16a34a; }

    /* 屏幕阅读器专用 */
    .cosy-login__visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }
</style>
