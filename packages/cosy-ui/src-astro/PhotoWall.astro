---
/**
 * @component PhotoWall
 *
 * @description
 * PhotoWall 组件采用不规则网格布局展示照片墙，支持多种尺寸卡片、悬停效果和中心标题。
 *
 * @usage
 * 基本用法：
 * ```astro
 * <PhotoWall photos={photos} />
 * ```
 *
 * 自定义样式：
 * ```astro
 * <PhotoWall photos={photos} hover clickable gap="md" padding="lg" rounded="lg" />
 * ```
 *
 * 带中心标题：
 * ```astro
 * <PhotoWall photos={photos} title="我的相册" subtitle="美好回忆" />
 * ```
 *
 * @props
 * @prop {PhotoCardData[]} photos - 照片卡片数据数组
 * @prop {('none'|'xs'|'sm'|'md'|'lg'|'xl'|'2xl'|'3xl'|'4xl')} [padding='md'] - 容器内边距
 * @prop {('none'|'sm'|'md'|'lg'|'xl'|'2xl'|'3xl'|'full')} [rounded='md'] - 卡片圆角
 * @prop {('none'|'xs'|'sm'|'md'|'lg'|'xl')} [gap='md'] - 卡片间距
 * @prop {boolean} [hover=true] - 是否启用悬停效果
 * @prop {boolean} [clickable=true] - 是否启用点击效果
 * @prop {string} [width='full'] - 容器宽度
 * @prop {BackgroundColor} [background] - 容器背景色
 * @prop {string} [border='none'] - 边框尺寸
 * @prop {boolean} [centered=true] - 是否居中
 * @prop {string} [title] - 中心标题
 * @prop {string} [subtitle] - 中心副标题
 * @prop {string} [class] - 自定义类名
 * @prop {string} [style] - 自定义样式
 */

import Container from "./Container.astro";
import type { BackgroundColor } from "../src/common/backgrounds";
import type { BorderSize, PaddingSize, RoundedSize } from "../src/common";
import type { Size } from "../src/common/size";

export type PhotoCardSize = "xs" | "sm" | "md" | "lg" | "xl";
export type PhotoCardShape = "square";
export type PhotoCardStyle = "default" | "gradient" | "image" | "text";

export interface PhotoCardData {
	id: string;
	src: string;
	alt?: string;
	title?: string;
	subtitle?: string;
	size?: PhotoCardSize;
	shape?: PhotoCardShape;
	style?: PhotoCardStyle;
	gradient?: string;
	backgroundColor?: string;
	textColor?: string;
	href?: string;
	target?: "_blank" | "_self";
}

export interface IPhotoWallProps {
	photos: PhotoCardData[];
	padding?: PaddingSize;
	rounded?: RoundedSize;
	gap?: "none" | "xs" | "sm" | "md" | "lg" | "xl";
	hover?: boolean;
	clickable?: boolean;
	width?: Size;
	background?: BackgroundColor;
	border?: BorderSize;
	centered?: boolean;
	title?: string;
	subtitle?: string;
	class?: string;
	style?: string;
}

const {
	photos,
	padding = "md",
	rounded = "md",
	gap = "md",
	hover = true,
	clickable = true,
	width = "full",
	background,
	border = "none",
	centered = true,
	title,
	subtitle,
	class: className = "",
	style: customStyle,
} = Astro.props as IPhotoWallProps & { class?: string; style?: string };

// Gap → BEM 修饰类
const gapModMap = {
	none: "cosy-photo-wall--gap-none",
	xs: "cosy-photo-wall--gap-xs",
	sm: "cosy-photo-wall--gap-sm",
	md: "cosy-photo-wall--gap-md",
	lg: "cosy-photo-wall--gap-lg",
	xl: "cosy-photo-wall--gap-xl",
} as const;

// Rounded → BEM 修饰类
const roundedModMap = {
	none: "cosy-photo-wall--rounded-none",
	sm: "cosy-photo-wall--rounded-sm",
	md: "cosy-photo-wall--rounded-md",
	lg: "cosy-photo-wall--rounded-lg",
	xl: "cosy-photo-wall--rounded-xl",
	"2xl": "cosy-photo-wall--rounded-2xl",
	"3xl": "cosy-photo-wall--rounded-3xl",
	full: "cosy-photo-wall--rounded-full",
} as const;

const wallClass = [
	"cosy-photo-wall",
	gapModMap[gap],
	roundedModMap[rounded],
	hover ? "cosy-photo-wall--hover" : "",
	clickable ? "cosy-photo-wall--clickable" : "",
	className,
]
	.filter(Boolean)
	.join(" ");

// 计算卡片网格布局
const getCardLayout = (index: number) => {
	const colSpan = 3;
	const rowSpan = 3;
	const itemsPerRow = 4;
	const currentRow = Math.floor(index / itemsPerRow);
	const currentCol = index % itemsPerRow;
	const colStart = currentCol * 3 + 1;
	const rowStart = currentRow * 3 + 1;
	const finalColStart = Math.min(colStart, 13 - colSpan);
	return {
		gridArea: `${rowStart} / ${finalColStart} / ${rowStart + rowSpan} / ${finalColStart + colSpan}`,
	};
};
---

<Container
	width={width}
	background={background}
	border={border}
	centered={centered}
	padding={padding}
	style={customStyle}
	class="cosy-photo-wall__container">
	<div class={wallClass}>
		{
			photos.map((photo, index) => {
				const layout = getCardLayout(index);
				return (
					<div
						class="cosy-photo-wall__card"
						style={`grid-area: ${layout.gridArea};`}
						data-photo-id={photo.id}>
						<img
							src={photo.src}
							alt={photo.alt || `Photo ${index + 1}`}
							class="cosy-photo-wall__img"
							loading="lazy"
						/>
						{(photo.title || photo.subtitle) && (
							<div class="cosy-photo-wall__overlay">
								{photo.title && (
									<h3 class="cosy-photo-wall__card-title">{photo.title}</h3>
								)}
								{photo.subtitle && (
									<p class="cosy-photo-wall__card-subtitle">{photo.subtitle}</p>
								)}
							</div>
						)}
					</div>
				);
			})
		}

		{/* 中心标题区域 */}
		{title && (
			<div class="cosy-photo-wall__center-title">
				<div class="cosy-photo-wall__center-title-inner">
					<div class="cosy-photo-wall__center-title-mask"></div>
					<div class="cosy-photo-wall__center-title-content">
						<h2 class="cosy-photo-wall__center-title-text">{title}</h2>
						{subtitle && (
							<p class="cosy-photo-wall__center-subtitle">{subtitle}</p>
						)}
					</div>
				</div>
			</div>
		)}
	</div>
</Container>

<style is:global>
	/* PhotoWall - 原生 CSS 实现 */
	.cosy-photo-wall {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		grid-auto-rows: minmax(0, 1fr);
		position: relative;
	}

	/* 间距 */
	.cosy-photo-wall--gap-none { gap: 0; }
	.cosy-photo-wall--gap-xs { gap: 0.25rem; }
	.cosy-photo-wall--gap-sm { gap: 0.5rem; }
	.cosy-photo-wall--gap-md { gap: 1rem; }
	.cosy-photo-wall--gap-lg { gap: 1.5rem; }
	.cosy-photo-wall--gap-xl { gap: 2rem; }

	/* 卡片 */
	.cosy-photo-wall__card {
		position: relative;
		overflow: hidden;
		aspect-ratio: 1 / 1;
		background: #f3f4f6;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* 圆角（卡片） */
	.cosy-photo-wall--rounded-none .cosy-photo-wall__card { border-radius: 0; }
	.cosy-photo-wall--rounded-sm .cosy-photo-wall__card { border-radius: 0.125rem; }
	.cosy-photo-wall--rounded-md .cosy-photo-wall__card { border-radius: 0.375rem; }
	.cosy-photo-wall--rounded-lg .cosy-photo-wall__card { border-radius: 0.5rem; }
	.cosy-photo-wall--rounded-xl .cosy-photo-wall__card { border-radius: 0.75rem; }
	.cosy-photo-wall--rounded-2xl .cosy-photo-wall__card { border-radius: 1rem; }
	.cosy-photo-wall--rounded-3xl .cosy-photo-wall__card { border-radius: 1.5rem; }
	.cosy-photo-wall--rounded-full .cosy-photo-wall__card { border-radius: 9999px; }

	/* 悬停 */
	.cosy-photo-wall--hover .cosy-photo-wall__card {
		transition: transform 0.3s ease;
	}
	.cosy-photo-wall--hover .cosy-photo-wall__card:hover {
		transform: scale(1.05);
	}

	/* 可点击 */
	.cosy-photo-wall--clickable .cosy-photo-wall__card {
		cursor: pointer;
	}

	.cosy-photo-wall__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	/* 卡片悬停遮罩 */
	.cosy-photo-wall__overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.2);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	.cosy-photo-wall__card:hover .cosy-photo-wall__overlay {
		opacity: 1;
	}
	.cosy-photo-wall__card-title {
		color: #fff;
		font-size: 0.875rem;
		font-weight: 500;
		text-align: center;
		padding: 0 0.5rem;
		margin: 0 0 0.25rem;
	}
	.cosy-photo-wall__card-subtitle {
		color: rgba(255, 255, 255, 0.8);
		font-size: 0.75rem;
		text-align: center;
		padding: 0 0.5rem;
		margin: 0;
	}

	/* 中心标题 */
	.cosy-photo-wall__center-title {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		pointer-events: none;
		z-index: 10;
	}
	.cosy-photo-wall__center-title-inner {
		position: relative;
		text-align: center;
		padding: 1.5rem;
	}
	.cosy-photo-wall__center-title-mask {
		position: absolute;
		inset: 0;
		background: rgba(255, 255, 255, 0.8);
		backdrop-filter: blur(4px);
		border-radius: 1rem;
	}
	.cosy-photo-wall__center-title-content {
		position: relative;
		z-index: 1;
	}
	.cosy-photo-wall__center-title-text {
		font-size: 2.25rem;
		font-weight: 700;
		color: #111827;
		margin: 0 0 0.5rem;
		line-height: 1.2;
	}
	.cosy-photo-wall__center-subtitle {
		font-size: 1.125rem;
		color: #4b5563;
		font-weight: 500;
		margin: 0;
	}
</style>
