---
/**
 * @component PictureBookTextBox
 *
 * @description
 * 文字容器，按百分比在父容器中绝对定位。采用容器查询单位实现"像图片一样同比缩放"。
 * 尺寸支持百分比，字体基于 cqw 按容器宽度同比缩放。
 *
 * @usage
 * ```astro
 * <PictureBookTextBox top={58} left={52} width={40} bg="paper"
 *   backdropBlur={4} paddingPx={12} roundedPx={12}>
 *   文字内容…
 * </PictureBookTextBox>
 * ```
 *
 * @props
 * - bottom?: number - 绝对定位 bottom（百分比）
 * - left?: number - 绝对定位 left（百分比）
 * - right?: number - 绝对定位 right（百分比）
 * - top?: number - 绝对定位 top（百分比）
 * - width?: number - 宽度（百分比）
 * - heightPx?: number - 高度（像素）
 * - height?: number - 高度（百分比）
 * - zIndex?: number - 层叠顺序，默认 10
 * - bg?: BackgroundColor - 预设背景色
 * - backdropBlur?: number - 背景虚化像素
 * - paddingPx?: number - 内边距（px）
 * - roundedPx?: number - 圆角（px）
 * - paddingCqw?: number - 同比缩放内边距（cqw）
 * - roundedCqw?: number - 同比缩放圆角（cqw）
 * - fontScaleCqw?: number - 字体缩放系数，默认 4（即 4cqw）
 *
 * @slots
 * - default: 文本内容插槽
 */


export interface IPictureBookTextBoxProps {
	top?: number;
	left?: number;
	right?: number;
	bottom?: number;
	width?: number;
	heightPx?: number;
	height?: number;
	zIndex?: number;
	bg?: BackgroundColor;
	backdropBlur?: number;
	paddingPx?: number;
	roundedPx?: number;
	paddingCqw?: number;
	roundedCqw?: number;
	fontScaleCqw?: number;
}

const props = Astro.props as IPictureBookTextBoxProps;

const pct = (v?: number) => (typeof v === "number" ? `${v}%` : undefined);

// 背景色 CSS 变量解析（corporate 主题色）
const bgColorVarMap: Record<string, string> = {
	primary: "#4b6bfb",
	secondary: "#7b92b2",
	accent: "#67baa3",
	neutral: "#181a2a",
	"base-100": "#ffffff",
	"base-200": "#e9e9e9",
	"base-300": "#d7d7d7",
	success: "#16a34a",
	warning: "#d97706",
	error: "#dc2626",
	info: "#2563eb",
};

function resolveBg(bg?: BackgroundColor): string {
	if (!bg) return "";
	const idx = bg.indexOf("/");
	const name = idx >= 0 ? bg.slice(0, idx) : bg;
	const op = idx >= 0 ? bg.slice(idx + 1) : "";
	const color = bgColorVarMap[name];
	if (!color) return "";
	if (!op) return `background-color: ${color};`;
	return `background-color: color-mix(in srgb, ${color} ${op}%, transparent);`;
}

const bgStyle = resolveBg(props.bg);

const paddingStyle = (() => {
	if (typeof props.paddingCqw === "number")
		return `padding: ${props.paddingCqw}cqw`;
	if (typeof props.paddingPx === "number")
		return `padding: ${props.paddingPx}px`;
	return "padding: 0";
})();

const radiusStyle = (() => {
	if (typeof props.roundedCqw === "number")
		return `border-radius: ${props.roundedCqw}cqw`;
	if (typeof props.roundedPx === "number")
		return `border-radius: ${props.roundedPx}px`;
	return "border-radius: 0";
})();

const styleList: string[] = [
	"position: absolute",
	`z-index: ${props.zIndex ?? 10}`,
	bgStyle,
	paddingStyle,
	radiusStyle,
	typeof props.backdropBlur === "number" && props.backdropBlur > 0
		? `backdrop-filter: blur(${props.backdropBlur}px)`
		: "",
	props.top !== undefined ? `top: ${pct(props.top)}` : "",
	props.left !== undefined ? `left: ${pct(props.left)}` : "",
	props.right !== undefined ? `right: ${pct(props.right)}` : "",
	props.bottom !== undefined ? `bottom: ${pct(props.bottom)}` : "",
	props.width !== undefined ? `width: ${pct(props.width)}` : "",
	props.height !== undefined ? `height: ${pct(props.height)}` : "",
	typeof props.heightPx === "number" ? `height: ${props.heightPx}px` : "",
	"container-type: inline-size",
	`font-size: ${typeof props.fontScaleCqw === "number" ? `${props.fontScaleCqw}cqw` : "4cqw"}`,
].filter(Boolean);

const inlineStyle = styleList.join("; ");
type BackgroundColor = string;

---

<div style={inlineStyle} class="cosy-pb-text-box">
	<slot />
</div>

<style is:global>
	/* PictureBookTextBox - 原生 CSS 实现 */
	.cosy-pb-text-box {
		pointer-events: auto;
		box-sizing: border-box;
	}
</style>
