---
/**
 * @component CodeExample
 *
 * @description
 * 用于展示组件示例及其源代码的组件。
 * 采用标签形式，默认显示预览，用户可以点击标签切换到源代码视图。
 * 支持亮色和暗黑模式，会根据系统设置自动切换主题。
 *
 * @usage
 * ```astro
 * <CodeExample
 *   title="示例标题"
 *   description="示例描述"
 *   code={`<Alert type="info">这是一个示例</Alert>`}
 * >
 *   <Alert type="info">这是一个示例</Alert>
 * </CodeExample>
 * ```
 *
 * @props
 * @prop {string} [title] - 示例标题
 * @prop {string} [description] - 示例描述
 * @prop {string} code - 要展示的源代码
 *
 * @slots
 * @slot default - 组件的实际渲染内容
 */

import { CheckIcon, ClipboardIcon } from "./icons";

interface Props {
	title?: string;
	description?: string;
	code: string;
}

const { title, description, code } = Astro.props;
---

<div class="cosy-code-example" data-role="code-example" ignore-heading>
	{
		title && (
			<h3 class="cosy-code-example__title">{title}</h3>
		)
	}
	{
		description && <p class="cosy-code-example__description">{description}</p>
	}

	<div class="cosy-code-example__toolbar">
		<div role="tablist" class="cosy-code-example__tabs">
			<button
				role="tab"
				class="cosy-code-example__tab cosy-code-example__tab--active"
				data-tab="preview"
				aria-selected="true">
				预览
			</button>
			<button
				role="tab"
				class="cosy-code-example__tab"
				data-tab="code"
				aria-selected="false">
				代码
			</button>
		</div>
		<button
			class="cosy-code-example__copy-btn"
			type="button"
			aria-label="复制代码">
			<span class="cosy-code-example__copy-icon"><ClipboardIcon /></span>
			<span class="cosy-code-example__check-icon">
				<CheckIcon />
			</span>
			<span class="cosy-code-example__copy-text">复制代码</span>
		</button>
	</div>

	<div class="cosy-code-example__body">
		<div
			class="cosy-code-example__panel cosy-code-example__panel--preview"
			data-panel="preview">
			<slot />
		</div>

		<div
			class="cosy-code-example__panel cosy-code-example__panel--hidden cosy-code-example__panel--code"
			data-panel="code">
			<pre class="cosy-code-example__pre" style="margin:0"><code class="cosy-code-example__code">{code}</code></pre>
		</div>
	</div>
</div>

<script>
	function initializeCodeExample() {
		document
			.querySelectorAll<HTMLElement>('[data-role="code-example"]')
			.forEach((example) => {
				if (example.hasAttribute("data-initialized")) return;
				example.setAttribute("data-initialized", "true");

				// 标签切换
				example
					.querySelectorAll<HTMLButtonElement>(".cosy-code-example__tab")
					.forEach((tab) => {
						tab.addEventListener("click", () => {
							const targetTab = tab.getAttribute("data-tab");
							if (!targetTab) return;

							example
								.querySelectorAll(".cosy-code-example__tab")
								.forEach((t) => {
									t.classList.remove(
										"cosy-code-example__tab--active",
									);
									t.setAttribute("aria-selected", "false");
								});
							tab.classList.add("cosy-code-example__tab--active");
							tab.setAttribute("aria-selected", "true");

							example
								.querySelectorAll("[data-panel]")
								.forEach((panel) => {
									if (
										panel.getAttribute("data-panel") === targetTab
									) {
										panel.classList.remove(
											"cosy-code-example__panel--hidden",
										);
									} else {
										panel.classList.add(
											"cosy-code-example__panel--hidden",
										);
									}
								});
						});
					});

				// 复制代码
				const copyBtn = example.querySelector<HTMLButtonElement>(
					".cosy-code-example__copy-btn",
				);
				if (copyBtn) {
					copyBtn.addEventListener("click", () => {
						const codePanel = example.querySelector(
							'[data-panel="code"]',
						);
						if (!codePanel) return;
						const codeElement = codePanel.querySelector("code");
						if (!codeElement) return;
						const code = codeElement.textContent || "";

						navigator.clipboard.writeText(code).then(() => {
							copyBtn.classList.add(
								"cosy-code-example__copy-btn--success",
							);
							copyBtn
								.querySelector(".cosy-code-example__copy-icon")
								?.classList.add("cosy-code-example__visually-hidden");
							copyBtn
								.querySelector(".cosy-code-example__check-icon")
								?.classList.remove(
									"cosy-code-example__visually-hidden",
								);
							copyBtn
								.querySelector(".cosy-code-example__copy-text")
								?.classList.add("cosy-code-example__copy-text--success");

							setTimeout(() => {
								copyBtn.classList.remove(
									"cosy-code-example__copy-btn--success",
								);
								copyBtn
									.querySelector(
										".cosy-code-example__copy-icon",
									)
									?.classList.remove(
										"cosy-code-example__visually-hidden",
									);
								copyBtn
									.querySelector(
										".cosy-code-example__check-icon",
									)
									?.classList.add(
										"cosy-code-example__visually-hidden",
									);
								copyBtn
									.querySelector(
										".cosy-code-example__copy-text",
									)
									?.classList.remove(
										"cosy-code-example__copy-text--success",
									);
							}, 3000);
						});
					});
				}
			});
	}

	initializeCodeExample();
	document.addEventListener("astro:page-load", initializeCodeExample);
</script>

<style is:global>
	/* CodeExample - 原生 CSS 实现（daisyUI corporate 主题色） */
	.cosy-code-example {
		--cosy-code-example-base-100: #ffffff;
		--cosy-code-example-base-200: #e9e9e9;
		--cosy-code-example-base-300: #d7d7d7;
		--cosy-code-example-base-content: #1d1d1d;
		--cosy-code-example-primary: #4b6bfb;
		--cosy-code-example-success: #16a34a;

		box-sizing: border-box;
		width: 100%;
		margin-bottom: 2rem;
		border: 1px solid var(--cosy-code-example-base-300);
		border-radius: 0.5rem;
		background: var(--cosy-code-example-base-100);
		color: var(--cosy-code-example-base-content);
		overflow: hidden;
	}

	.cosy-code-example__title {
		margin: 0;
		padding: 1rem;
		font-weight: 600;
		font-size: 1rem;
		border-bottom: 1px solid var(--cosy-code-example-base-300);
	}

	.cosy-code-example__description {
		margin: 0;
		padding: 1rem 1rem 0;
		font-size: 0.875rem;
		opacity: 0.7;
	}

	.cosy-code-example__toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 1rem;
		background: var(--cosy-code-example-base-200);
		border-radius: 0.5rem 0.5rem 0 0;
	}

	.cosy-code-example__tabs {
		display: flex;
		gap: 0.25rem;
	}

	.cosy-code-example__tab {
		padding: 0.5rem 0.75rem;
		border: none;
		background: transparent;
		color: var(--cosy-code-example-base-content);
		font-size: 0.875rem;
		cursor: pointer;
		border-bottom: 2px solid transparent;
		transition: color 0.15s ease, border-color 0.15s ease;
	}
	.cosy-code-example__tab:hover {
		color: var(--cosy-code-example-primary);
	}
	.cosy-code-example__tab--active {
		color: var(--cosy-code-example-primary);
		border-bottom-color: var(--cosy-code-example-primary);
		font-weight: 600;
	}

	.cosy-code-example__copy-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.375rem 0.75rem;
		border: none;
		border-radius: 0.5rem;
		background: transparent;
		color: var(--cosy-code-example-base-content);
		font-size: 0.875rem;
		cursor: pointer;
		transition: background-color 0.15s ease, color 0.15s ease;
	}
	.cosy-code-example__copy-btn:hover {
		background: color-mix(in srgb, currentColor 10%, transparent);
	}
	.cosy-code-example__copy-btn--success {
		color: var(--cosy-code-example-success);
	}

	.cosy-code-example__copy-icon,
	.cosy-code-example__check-icon {
		display: inline-flex;
		width: 1rem;
		height: 1rem;
	}

	.cosy-code-example__check-icon {
		color: var(--cosy-code-example-success);
	}

	.cosy-code-example__visually-hidden {
		display: none;
	}

	.cosy-code-example__copy-text--success {
		color: var(--cosy-code-example-success);
	}

	.cosy-code-example__body {
		position: relative;
		padding: 1rem;
		background: linear-gradient(135deg, #fef2f2, #dcfce7);
		border-radius: 0 0 0.5rem 0.5rem;
	}

	.cosy-code-example__panel {
		display: block;
	}

	.cosy-code-example__panel--hidden {
		display: none;
	}

	.cosy-code-example__pre {
		overflow-x: auto;
		margin: 0;
		padding: 0.5rem;
		background: var(--cosy-code-example-base-100);
		border-radius: 0.375rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
			monospace;
		font-size: 0.875rem;
	}

	.cosy-code-example__code {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
			monospace;
	}
</style>
