        .cosy-grid--2xl-cols-10 { grid-template-columns: repeat(10, minmax(0, 1fr)); }
        .cosy-grid--2xl-cols-11 { grid-template-columns: repeat(11, minmax(0, 1fr)); }
        .cosy-grid--2xl-cols-12 { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    }

    /* 间距（spacing 1 = 0.25rem） */
    .cosy-grid--gap-none { gap: 0; }
    .cosy-grid--gap-xs { gap: 0.5rem; }
    .cosy-grid--gap-sm { gap: 1rem; }
    .cosy-grid--gap-md { gap: 1.5rem; }
    .cosy-grid--gap-lg { gap: 2rem; }
    .cosy-grid--gap-xl { gap: 3rem; }

    .cosy-grid--row-gap-none { row-gap: 0; }
    .cosy-grid--row-gap-xs { row-gap: 0.5rem; }
    .cosy-grid--row-gap-sm { row-gap: 1rem; }
    .cosy-grid--row-gap-md { row-gap: 1.5rem; }
    .cosy-grid--row-gap-lg { row-gap: 2rem; }
    .cosy-grid--row-gap-xl { row-gap: 3rem; }

    .cosy-grid--col-gap-none { column-gap: 0; }
    .cosy-grid--col-gap-xs { column-gap: 0.5rem; }
    .cosy-grid--col-gap-sm { column-gap: 1rem; }
    .cosy-grid--col-gap-md { column-gap: 1.5rem; }
    .cosy-grid--col-gap-lg { column-gap: 2rem; }
    .cosy-grid--col-gap-xl { column-gap: 3rem; }

    /* 垂直外边距 */
    .cosy-grid--my-none { margin-top: 0; margin-bottom: 0; }
    .cosy-grid--my-xs { margin-top: 0.5rem; margin-bottom: 0.5rem; }
    .cosy-grid--my-sm { margin-top: 1rem; margin-bottom: 1rem; }
    .cosy-grid--my-md { margin-top: 1.5rem; margin-bottom: 1.5rem; }
    .cosy-grid--my-lg { margin-top: 2rem; margin-bottom: 2rem; }
    .cosy-grid--my-xl { margin-top: 3rem; margin-bottom: 3rem; }

    /* 边框 */
    .cosy-grid--border {
        border: 1px solid #d7d7d7;
        border-radius: 0.5rem;
    }
</style>
