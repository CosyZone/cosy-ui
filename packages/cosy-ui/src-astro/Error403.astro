---
/**
 * @component Error403
 *
 * @description
 * 403 禁止访问错误页面组件，用于显示用户无权限访问页面的提示信息。
 *
 * @usage
 * ```astro
 * <Error403 loginUrl="/login" contactUrl="/contact" />
 * ```
 *
 * @props
 * @prop {Record<string, string>} [debugKVs={}] - 调试信息键值对
 * @prop {string} [loginUrl] - 登录页面 URL，提供后显示登录按钮
 * @prop {string} [contactUrl] - 联系我们页面 URL，提供后显示联系按钮
 */

import { LinkUtil } from './internal/utils/link';
import Button from './Button.astro';

const baseUrl = LinkUtil.getBaseUrl();
const path = Astro.url.pathname;

export interface Error403Props {
    debugKVs?: Record<string, string>;
    loginUrl?: string;
    contactUrl?: string;
}

const { debugKVs = {}, loginUrl, contactUrl } = Astro.props as Error403Props;
---

<div class="cosy-error-page cosy-error-page--warning">
    <div class="cosy-error-page__content">
        <div class="cosy-error-page__code-container">
            <h1 class="cosy-error-page__code">403</h1>
            <div class="cosy-error-page__line"></div>
        </div>

        <div class="cosy-error-page__message-container">
            <h2 class="cosy-error-page__title">禁止访问</h2>
            <p class="cosy-error-page__text">抱歉，您没有权限访问此页面。</p>
        </div>

        <div class="cosy-error-page__path">
            <p>
                <span class="cosy-error-page__path-label">路径：</span><code>{path}</code>
            </p>
        </div>

        {
            Object.keys(debugKVs).length > 0 && (
                <details class="cosy-error-page__debug">
                    <summary class="cosy-error-page__debug-summary">权限信息</summary>
                    <div class="cosy-error-page__debug-content">
                        {Object.entries(debugKVs).map(([key, value]) => (
                            <div class="cosy-error-page__debug-item">
                                <span class="cosy-error-page__debug-key">{key}:</span>
                                <span class="cosy-error-page__debug-value">{value}</span>
                            </div>
                        ))}
                    </div>
                </details>
            )
        }

        <div class="cosy-error-page__actions">
            {loginUrl && <Button href={loginUrl} variant="primary" block>登录账户</Button>}
            <Button href={baseUrl} variant="outline" block>返回首页</Button>
            {contactUrl && <Button href={contactUrl} variant="ghost" block>联系管理员</Button>}
        </div>

        <div class="cosy-error-page__help">
            <p>如需访问权限，请联系系统管理员</p>
        </div>
    </div>
</div>

<style is:global>
    /* Error 页面共享样式 - 原生 CSS（daisyui corporate 主题色） */
    .cosy-error-page {
        --cosy-error-base-100: #ffffff;
        --cosy-error-base-200: #e9e9e9;
        --cosy-error-base-content: #1d1d1d;
        --cosy-error-primary: #4b6bfb;
        --cosy-error-warning: #d97706;
        --cosy-error-error: #dc2626;
        --cosy-error-info: #2563eb;
        --cosy-error-success: #16a34a;

        box-sizing: border-box;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: var(--cosy-error-base-100);
        color: var(--cosy-error-base-content);
    }
    .cosy-error-page--primary { --cosy-error-accent: var(--cosy-error-primary); }
    .cosy-error-page--warning { --cosy-error-accent: var(--cosy-error-warning); }
    .cosy-error-page--error { --cosy-error-accent: var(--cosy-error-error); }
    .cosy-error-page--info { --cosy-error-accent: var(--cosy-error-info); }

    .cosy-error-page__content { width: 100%; max-width: 28rem; text-align: center; display: flex; flex-direction: column; gap: 1.5rem; }
    .cosy-error-page__code-container { margin-bottom: 2rem; }
    .cosy-error-page__code { margin: 0; font-size: 9rem; font-weight: 700; line-height: 1; color: var(--cosy-error-accent); }
    .cosy-error-page__line { width: 6rem; height: 0.25rem; margin: 1rem auto 0; border-radius: 9999px; background: var(--cosy-error-accent); }
    .cosy-error-page__message-container { display: flex; flex-direction: column; gap: 1rem; }
    .cosy-error-page__title { margin: 0; font-size: 1.5rem; font-weight: 600; }
    .cosy-error-page__text { margin: 0; font-size: 1.125rem; color: color-mix(in srgb, var(--cosy-error-base-content) 70%, transparent); }
    .cosy-error-page__path { padding: 1rem; border-radius: 0.5rem; background: var(--cosy-error-base-200); font-size: 0.875rem; color: color-mix(in srgb, var(--cosy-error-base-content) 60%, transparent); text-align: left; }
    .cosy-error-page__path p { margin: 0; }
    .cosy-error-page__path-label { font-weight: 500; }
    .cosy-error-page__path code { color: var(--cosy-error-accent); }
    .cosy-error-page__debug { padding: 1rem; border-radius: 0.5rem; background: var(--cosy-error-base-200); text-align: left; }
    .cosy-error-page__debug-summary { cursor: pointer; font-weight: 500; }
    .cosy-error-page__debug-content { margin-top: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem; }
    .cosy-error-page__debug-item { font-size: 0.875rem; }
    .cosy-error-page__debug-key { font-weight: 500; }
    .cosy-error-page__debug-value { margin-left: 0.5rem; color: color-mix(in srgb, var(--cosy-error-base-content) 70%, transparent); }
    .cosy-error-page__actions { display: flex; flex-direction: column; gap: 0.75rem; }
    .cosy-error-page__help { margin-top: 2rem; font-size: 0.875rem; color: color-mix(in srgb, var(--cosy-error-base-content) 50%, transparent); }
</style>
