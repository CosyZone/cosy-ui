		"shiki": "^3.14.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^24.9.2",
		"astro": "^7.4.13",
		"fs-extra": "^11.3.2",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
